---
// Interactive knowledge-graph explorer. Reads /graph.json (emitted by
// `lokf export`): nodes are concepts, edges are RDF predicates. Search dims
// non-matching nodes; the filters toggle node types and predicates; clicking a
// node opens its details. Themed with Starlight's CSS variables.
---

<div
  class="lokf-graph"
  data-graph-src={import.meta.env.BASE_URL.replace(/\/$/, "") + "/graph.json"}
>
  <div class="lokf-graph__controls">
    <input
      type="search"
      class="lokf-graph__search"
      placeholder="Search nodes by label…"
      autocomplete="off"
    />
    <p class="lokf-graph__shown" aria-live="polite" hidden></p>
    <div class="lokf-graph__filters">
      <fieldset class="lokf-graph__fieldset" data-filter="type">
        <legend>Node types</legend>
      </fieldset>
      <fieldset class="lokf-graph__fieldset" data-filter="predicate">
        <legend>Predicates</legend>
      </fieldset>
    </div>
  </div>
  <div class="lokf-graph__stage">
    <div class="lokf-graph__toolbar">
      <button type="button" class="lokf-graph__btn" data-action="fit" title="Fit graph to view">
        ⤢ Fit
      </button>
      <button
        type="button"
        class="lokf-graph__btn"
        data-action="fullscreen"
        title="Open the full-screen graph browser"
      >
        ⛶ Full screen
      </button>
    </div>
    <div class="lokf-graph__canvas"></div>
    <aside class="lokf-graph__detail" hidden>
      <button type="button" class="lokf-graph__close" aria-label="Close">&times;</button>
      <h3 class="lokf-graph__detail-title"></h3>
      <dl>
        <dt>Type</dt><dd class="lokf-graph__detail-type"></dd>
        <dt>Trust</dt><dd class="lokf-graph__detail-trust"></dd>
        <dt>IRI</dt><dd class="lokf-graph__detail-iri lokf-graph__mono"></dd>
        <dt>Concept ID</dt><dd class="lokf-graph__detail-cid lokf-graph__mono"></dd>
      </dl>
      <a class="lokf-graph__detail-src" href="#" rel="noopener" hidden>View source file →</a>
    </aside>
  </div>
</div>

<script>
  import cytoscape from "cytoscape";
  import fcose from "cytoscape-fcose";

  cytoscape.use(fcose);

  const PALETTE = [
    "#5b8def", "#e8833a", "#2ea77d", "#c1558b",
    "#9b6dd6", "#d2b13a", "#4bacc6", "#d05b5b",
  ];

  type Elements = {
    nodes: { data: Record<string, string> }[];
    edges: { data: Record<string, string> }[];
    meta?: { source_base?: string };
  };

  function themeColor(name: string, fallback: string): string {
    const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    return v || fallback;
  }

  function init(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = "1";
    const src = root.dataset.graphSrc!;
    fetch(src)
      .then((r) => r.json())
      .then((graph: Elements) => render(root, graph))
      .catch((e) => {
        const stage = root.querySelector(".lokf-graph__canvas") as HTMLElement;
        stage.textContent = "Could not load graph: " + e;
      });
  }

  function render(root: HTMLElement, graph: Elements) {
    const mount = root.querySelector(".lokf-graph__canvas") as HTMLElement;
    const sourceBase = graph.meta?.source_base ?? "";

    const types = [...new Set(graph.nodes.map((n) => n.data.type))].sort();
    const colorOf: Record<string, string> = {};
    types.forEach((t, i) => (colorOf[t] = PALETTE[i % PALETTE.length]));
    graph.nodes.forEach((n) => (n.data.color = colorOf[n.data.type]));
    const predicates = [...new Set(graph.edges.map((e) => e.data.predicate))].sort();

    const fg = themeColor("--sl-color-text", "#333");
    const line = themeColor("--sl-color-gray-3", "#888");

    const cy = cytoscape({
      container: mount,
      elements: graph,
      minZoom: 0.2,
      maxZoom: 2.5,
      wheelSensitivity: 0.3,
      layout: {
        name: "fcose",
        quality: "proof",
        animate: false,
        padding: 50,
        nodeSeparation: 160,
        idealEdgeLength: 150,
        nodeRepulsion: 7000,
        gravity: 0.2,
        fit: true,
      },
      style: [
        {
          selector: "node",
          style: {
            "background-color": "data(color)",
            label: "data(label)",
            color: fg,
            "font-size": "11px",
            "text-wrap": "wrap",
            "text-max-width": "120px",
            "text-valign": "bottom",
            "text-margin-y": 4,
            width: 26,
            height: 26,
          },
        },
        {
          selector: "edge",
          style: {
            label: "data(predicate)",
            "font-size": "9px",
            color: line,
            "line-color": line,
            "target-arrow-color": line,
            "target-arrow-shape": "triangle",
            "curve-style": "bezier",
            width: 1.5,
            "text-rotation": "autorotate",
          },
        },
        { selector: ".dim", style: { opacity: 0.15 } },
        { selector: ".hidden", style: { display: "none" } },
      ],
    });

    // Filters: a checkbox per type and per predicate.
    const typeBox = root.querySelector('[data-filter="type"]') as HTMLElement;
    const predBox = root.querySelector('[data-filter="predicate"]') as HTMLElement;
    const tally = (values: string[]) =>
      values.reduce((m, v) => m.set(v, (m.get(v) ?? 0) + 1), new Map<string, number>());
    const typeCount = tally(graph.nodes.map((n) => n.data.type));
    const predCount = tally(graph.edges.map((e) => e.data.predicate));
    const checkbox = (value: string, count: number, swatch?: string) => {
      const label = document.createElement("label");
      const input = document.createElement("input");
      input.type = "checkbox";
      input.checked = true;
      input.value = value;
      label.append(input);
      if (swatch) {
        const dot = document.createElement("span");
        dot.className = "lokf-graph__swatch";
        dot.style.background = swatch;
        label.append(dot);
      }
      const name = document.createElement("span");
      name.textContent = value;
      const tallied = document.createElement("span");
      tallied.className = "lokf-graph__count";
      tallied.textContent = String(count);
      label.append(name, tallied);
      input.addEventListener("change", applyFilters);
      return label;
    };
    types.forEach((t) => typeBox.append(checkbox(t, typeCount.get(t) ?? 0, colorOf[t])));
    predicates.forEach((p) => predBox.append(checkbox(p, predCount.get(p) ?? 0)));
    // "All" and "None" on each group, so a reader with many boxes can keep
    // one or two in two clicks.
    [typeBox, predBox].forEach((box) => {
      const bar = document.createElement("div");
      bar.className = "lokf-graph__all";
      for (const [text, on] of [["All", true], ["None", false]] as const) {
        const b = document.createElement("button");
        b.type = "button";
        b.textContent = text;
        b.addEventListener("click", () => {
          box.querySelectorAll<HTMLInputElement>("input").forEach((i) => (i.checked = on));
          applyFilters();
        });
        bar.append(b);
      }
      box.querySelector("legend")!.after(bar);
    });
    const shown = root.querySelector(".lokf-graph__shown") as HTMLElement;

    function checkedValues(box: HTMLElement) {
      return new Set(
        [...box.querySelectorAll<HTMLInputElement>("input:checked")].map((i) => i.value),
      );
    }
    function applyFilters() {
      const okTypes = checkedValues(typeBox);
      const okPreds = checkedValues(predBox);
      cy.nodes().forEach((n) => n.toggleClass("hidden", !okTypes.has(n.data("type"))));
      cy.edges().forEach((e) =>
        e.toggleClass("hidden", !okPreds.has(e.data("predicate"))),
      );
      // A filter that hides anything says so, so no part of the graph goes
      // missing unremarked.
      const filtered = root.querySelector(".lokf-graph__filters input:not(:checked)") !== null;
      shown.hidden = !filtered;
      shown.textContent = `${cy.nodes(":visible").length} of ${cy.nodes().length} concepts shown`;
    }

    // Search dims non-matching nodes.
    const search = root.querySelector(".lokf-graph__search") as HTMLInputElement;
    search.addEventListener("input", () => {
      const q = search.value.trim().toLowerCase();
      cy.nodes().forEach((n) =>
        n.toggleClass("dim", q !== "" && !n.data("label").toLowerCase().includes(q)),
      );
    });

    // Detail panel on node click.
    const detail = root.querySelector(".lokf-graph__detail") as HTMLElement;
    const set = (sel: string, text: string) => {
      (root.querySelector(sel) as HTMLElement).textContent = text;
    };
    cy.on("tap", "node", (evt) => {
      const d = evt.target.data();
      set(".lokf-graph__detail-title", d.label);
      set(".lokf-graph__detail-type", d.type);
      // OKF v0.2 trust signals: "human-reviewed · stable" (+ " · stale").
      const trust = [d.trust_tier, d.status, d.stale ? "stale" : ""]
        .filter(Boolean)
        .join(" · ");
      set(".lokf-graph__detail-trust", trust || "—");
      set(".lokf-graph__detail-iri", d.id);
      set(".lokf-graph__detail-cid", d.concept_id);
      const link = root.querySelector(".lokf-graph__detail-src") as HTMLAnchorElement;
      if (sourceBase && d.concept_id) {
        link.href = sourceBase.replace(/\/$/, "") + "/" + d.concept_id + ".md";
        link.hidden = false;
      } else {
        link.hidden = true;
      }
      detail.hidden = false;
    });
    (root.querySelector(".lokf-graph__close") as HTMLElement).addEventListener(
      "click",
      () => (detail.hidden = true),
    );

    // Zoom to fit once the force layout settles (fcose fits too, but a re-fit
    // after the container has its final size avoids the "too zoomed in" start).
    const fit = () => cy.fit(undefined, 45);
    cy.one("layoutstop", () => requestAnimationFrame(fit));

    // Toolbar: fit + a full-screen graph browser (the whole explorer — search,
    // filters, and graph — fills the viewport).
    root.querySelector('[data-action="fit"]')!.addEventListener("click", fit);
    const fsBtn = root.querySelector('[data-action="fullscreen"]') as HTMLButtonElement;
    fsBtn.addEventListener("click", () => {
      if (document.fullscreenElement) document.exitFullscreen();
      else root.requestFullscreen?.();
    });
    document.addEventListener("fullscreenchange", () => {
      const full = document.fullscreenElement === root;
      root.classList.toggle("is-fullscreen", full);
      fsBtn.textContent = full ? "⛶ Exit full screen" : "⛶ Full screen";
      // Let the layout reflow to the new size before resizing the canvas.
      requestAnimationFrame(() => {
        cy.resize();
        fit();
      });
    });
  }

  // This module script is deferred, so the DOM is ready — boot now. Also
  // re-boot on Astro client navigation, when view transitions are enabled.
  const boot = () =>
    document.querySelectorAll<HTMLElement>(".lokf-graph").forEach(init);
  boot();
  document.addEventListener("astro:page-load", boot);
</script>

<style is:global>
  /* Global (not scoped): the filter labels/swatches are created in JS and
     wouldn't carry Astro's scope hash. All selectors are .lokf-graph__* . */
  .lokf-graph {
    margin: 1.5rem 0 2rem;
  }
  .lokf-graph__controls {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 0.8rem;
  }
  .lokf-graph__search {
    width: 100%;
    padding: 0.5rem 0.7rem;
    font-size: 0.9rem;
    color: var(--sl-color-text);
    background: var(--sl-color-black);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.4rem;
  }
  .lokf-graph__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }
  .lokf-graph__fieldset {
    flex: 1 1 13rem;
    min-width: 12rem;
    padding: 0.4rem 0.8rem 0.7rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.4rem;
  }
  .lokf-graph__fieldset legend {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--sl-color-gray-2);
    padding: 0 0.3rem;
  }
  /* Each row is a whole click target, so the filters read as controls. */
  .lokf-graph__fieldset label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.2rem 0.4rem;
    font-size: 0.9rem;
    line-height: 1.6;
    border-radius: 0.3rem;
    cursor: pointer;
  }
  .lokf-graph__fieldset label:hover {
    background: var(--sl-color-gray-6);
  }
  .lokf-graph__fieldset input[type="checkbox"] {
    width: 1rem;
    height: 1rem;
    margin: 0;
    flex: none;
    accent-color: var(--sl-color-accent);
    cursor: pointer;
  }
  .lokf-graph__count {
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
    font-variant-numeric: tabular-nums;
  }
  .lokf-graph__fieldset .lokf-graph__all {
    display: flex;
    gap: 0.4rem;
    margin: 0.1rem 0 0.3rem;
  }
  .lokf-graph__all button {
    font-size: 0.72rem;
    padding: 0.1rem 0.55rem;
    color: var(--sl-color-text);
    background: var(--sl-color-black);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.3rem;
    cursor: pointer;
  }
  .lokf-graph__all button:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent-high);
  }
  .lokf-graph .lokf-graph__shown {
    margin: 0;
    font-size: 0.8rem;
    color: var(--sl-color-gray-2);
  }
  .lokf-graph__swatch {
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    flex: none;
  }
  .lokf-graph__stage {
    position: relative;
  }
  .lokf-graph__toolbar {
    position: absolute;
    top: 0.55rem;
    left: 0.55rem;
    z-index: 3;
    display: flex;
    gap: 0.4rem;
  }
  .lokf-graph__btn {
    font-size: 0.75rem;
    padding: 0.28rem 0.6rem;
    color: var(--sl-color-text);
    background: var(--sl-color-black);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.35rem;
    cursor: pointer;
    line-height: 1.4;
  }
  .lokf-graph__btn:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent-high);
  }
  .lokf-graph__canvas {
    width: 100%;
    height: 60vh;
    min-height: 460px;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-7, var(--sl-color-black));
  }
  /* Full-screen graph browser: search and filters in a side panel that
     scrolls on its own, and the graph stage takes the rest, so however many
     filters there are, the graph keeps the full height. */
  .lokf-graph.is-fullscreen {
    margin: 0;
    padding: 1rem;
    display: grid;
    grid-template-columns: minmax(12rem, 18rem) 1fr;
    grid-template-rows: minmax(0, 1fr);
    gap: 1rem;
    background: var(--sl-color-bg);
  }
  .lokf-graph.is-fullscreen .lokf-graph__controls {
    min-height: 0;
    margin: 0;
    overflow-y: auto;
  }
  .lokf-graph.is-fullscreen .lokf-graph__filters {
    flex-direction: column;
  }
  .lokf-graph.is-fullscreen .lokf-graph__fieldset {
    flex: none;
    min-width: 0;
  }
  .lokf-graph.is-fullscreen .lokf-graph__stage {
    min-height: 0;
  }
  .lokf-graph.is-fullscreen .lokf-graph__canvas {
    height: 100%;
    min-height: 0;
  }
  .lokf-graph__detail {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    width: min(20rem, 82%);
    padding: 0.9rem 1.1rem 1rem;
    font-size: 0.82rem;
    color: var(--sl-color-text);
    background: var(--sl-color-black);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    box-shadow: var(--sl-shadow-md);
  }
  .lokf-graph__detail h3 {
    margin: 0 1.5rem 0.6rem 0;
    font-size: 1rem;
  }
  .lokf-graph__detail dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.15rem 0.6rem;
    margin: 0 0 0.7rem;
  }
  .lokf-graph__detail dt {
    font-weight: 700;
    color: var(--sl-color-gray-2);
  }
  .lokf-graph__detail dd {
    margin: 0;
    word-break: break-all;
  }
  .lokf-graph__mono {
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.76rem;
  }
  .lokf-graph__close {
    position: absolute;
    top: 0.3rem;
    right: 0.5rem;
    border: 0;
    background: none;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    color: var(--sl-color-gray-2);
  }
</style>
