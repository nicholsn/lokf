### OKF v0.2 post-generation axioms (lokf-build) ###
@prefix lokf: <https://w3id.org/lokf/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

lokf:Verification rdfs:subClassOf prov:Activity .

lokf:StringParameter a owl:Class ;
    rdfs:subClassOf lokf:Parameter ;
    lokf:xsd_value_space xsd:string .
lokf:IntegerParameter a owl:Class ;
    rdfs:subClassOf lokf:Parameter ;
    lokf:xsd_value_space xsd:integer .
lokf:NumberParameter a owl:Class ;
    rdfs:subClassOf lokf:Parameter ;
    lokf:xsd_value_space xsd:decimal .
lokf:BooleanParameter a owl:Class ;
    rdfs:subClassOf lokf:Parameter ;
    lokf:xsd_value_space xsd:boolean .
lokf:DateParameter a owl:Class ;
    rdfs:subClassOf lokf:Parameter ;
    lokf:xsd_value_space xsd:date .
lokf:DatetimeParameter a owl:Class ;
    rdfs:subClassOf lokf:Parameter ;
    lokf:xsd_value_space xsd:dateTime .
lokf:TimeParameter a owl:Class ;
    rdfs:subClassOf lokf:Parameter ;
    lokf:xsd_value_space xsd:time .
lokf:UriParameter a owl:Class ;
    rdfs:subClassOf lokf:Parameter ;
    lokf:xsd_value_space xsd:anyURI .
lokf:JsonParameter a owl:Class ;
    rdfs:subClassOf lokf:Parameter ;
    lokf:xsd_value_space rdf:JSON .
