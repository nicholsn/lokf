            sh:path lokf:relations ],
        [ sh:datatype xsd:dateTime ;
            sh:description "ISO 8601 datetime the concept was created." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path schema1:dateCreated ],
        [ sh:class lokf:Concept ;
            sh:description "The target concept that this concept is a part of." ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path dcterms:isPartOf ],
        [ sh:description "The `{ from, to }` date range framing every `usage_count`. Attached both to Concept (the shared window, sibling of `sources`) and to Source (a per-entry override)." ;
            sh:maxCount 1 ;
            sh:node lokf:UsageWindowShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 27 ;
            sh:path lokf:usageWindow ],
        [ sh:class lokf:Concept ;
            sh:description "An IRI asserting this concept is the same entity as another." ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path schema1:sameAs ],
        [ sh:description "How and when the current content was produced: `by` (REQUIRED actor) and `at` (ISO 8601 datetime). Supersedes the v0.1 `timestamp` field; consumers MAY fall back to `timestamp` when `generated` is absent." ;
            sh:maxCount 1 ;
            sh:node lokf:GenerationShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 28 ;
            sh:path prov:wasGeneratedBy ] ;
    sh:targetClass lokf:Tutorial .

schema1:DefinedTerm rdfs:subClassOf lokf:Concept .

schema1:Organization rdfs:subClassOf prov:Agent,
        lokf:Concept .

schema1:OrganizationRole rdfs:subClassOf lokf:Concept .

schema1:Person rdfs:subClassOf prov:Agent,
        lokf:Concept .

schema1:WebAPI rdfs:subClassOf lokf:Concept .

lokf:AttestedComputation rdfs:subClassOf lokf:Concept .

lokf:AttesterShape a sh:NodeShape ;
    rdfs:comment "The deterministic, non-LLM check for an Attested Computation (OKF v0.2 §10.2): `resource` names code that takes a run's receipt and returns a verdict, run consumer-side. Honestly lokf-minted." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:description "Path or URL to the deterministic verdict code." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:url ] .

lokf:BooleanParameter rdfs:subClassOf lokf:Parameter .

lokf:ConceptShape a sh:NodeShape ;
    rdfs:comment "A single unit of knowledge within a bundle, represented as one markdown document. The abstract base of every LOKF type. Its own IRI (`id`) is the RDF subject; the markdown body and typed relations become triples about that subject." ;
    sh:closed false ;
    sh:ignoredProperties ( schema1:alternateName schema1:documentation schema1:endDate schema1:httpMethod schema1:memberOf schema1:roleName schema1:runtimePlatform schema1:startDate schema1:unitText rdf:type skos:definition dcat:distribution org:member lokf:attester lokf:computation lokf:executor lokf:field lokf:formula lokf:measures lokf:parameter ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Short cross-cutting keywords for categorization." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path schema1:keywords ],
        [ sh:description "The concept's stable IRI. By convention it is the bundle base IRI joined with the Concept ID (the file path within the bundle, minus the `.md` suffix). Becomes the JSON-LD @id / RDF subject." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path schema1:identifier ],
        [ sh:description "The `{ from, to }` date range framing every `usage_count`. Attached both to Concept (the shared window, sibling of `sources`) and to Source (a per-entry override)." ;
            sh:maxCount 1 ;
            sh:node lokf:UsageWindowShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 27 ;
            sh:path lokf:usageWindow ],
        [ sh:datatype xsd:string ;
            sh:description "The level of education the concept is written for, in words or as the IRI of a level in a published framework, such as a level of ISCED 2011." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 35 ;
            sh:path schema1:educationalLevel ],
        [ sh:class lokf:Concept ;
            sh:description "A concept that supersedes this one, without asserting equivalence." ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path dcterms:isReplacedBy ],
        [ sh:datatype xsd:anyURI ;
            sh:description "The license under which the concept or bundle is offered." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path schema1:license ],
        [ sh:class lokf:Concept ;
            sh:description "The subject matter this concept is about." ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path schema1:about ],
        [ sh:datatype xsd:string ;
            sh:description "The producer's own `type` string when it names no LOKF class." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path schema1:additionalType ],
        [ sh:class lokf:Concept ;
            sh:description "A concept that is a part of this concept." ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path schema1:hasPart ],
        [ sh:class lokf:Concept ;
            sh:description "A concept or resource this concept refers to." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path dcterms:references ],
        [ sh:description "Verification events confirming the content against its sources or resource. Independent of `generated`: who wrote a concept need not be who confirmed it. Trust tiers derive from the actors: absent = unverified; only non-human actors = machine-confirmed; any `human:<id>` actor = human-reviewed." ;
            sh:node lokf:VerificationShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 29 ;
            sh:path lokf:verified ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The absolute instant on or after which the concept is stale (OKF §5.5: stale when now >= stale_after), an ISO 8601 datetime. A bare YYYY-MM-DD is read as that day at 00:00:00Z." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path schema1:expires ],
        [ sh:description "The agent(s) responsible for authoring the concept." ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:node lokf:AgentShape ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 10 ;
            sh:path schema1:author ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable display name." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:name ],
        [ sh:description "External sources supporting claims in the body." ;
            sh:node lokf:CitationShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path schema1:citation ],
        [ sh:datatype xsd:string ;
            sh:description "A version string for the concept's content." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path schema1:version ],
        [ sh:datatype xsd:anyURI ;
            sh:description "A URI that uniquely identifies the underlying real-world asset the concept describes (a table console URL, an API base URL, etc.). Absent for purely abstract concepts." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path schema1:url ],
        [ sh:class lokf:Concept ;
            sh:description "The target concept that this concept is a part of." ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path dcterms:isPartOf ],
        [ sh:description "Typed relationships whose predicate is not covered by a named relation slot. Each entry is a reified Relation (predicate + target)." ;
            sh:node lokf:RelationShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path lokf:relations ],
        [ sh:description "How and when the current content was produced: `by` (REQUIRED actor) and `at` (ISO 8601 datetime). Supersedes the v0.1 `timestamp` field; consumers MAY fall back to `timestamp` when `generated` is absent." ;
            sh:maxCount 1 ;
            sh:node lokf:GenerationShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 28 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class lokf:Concept ;
            sh:description "An IRI asserting this concept is the same entity as another." ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path schema1:sameAs ],
        [ sh:class lokf:Concept ;
            sh:description "A resource that formally defines this concept." ;
            sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path rdfs:isDefinedBy ],
        [ sh:description "The concept's type - OKF's single required field. SHOULD name a LOKF class (e.g. Metric, Dataset, Table, Playbook, GlossaryTerm)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path rdf:type ],
        [ sh:description "The readers this concept is written for, such as readers aged 13 to 18, as an inlined Audience. Absent means the bundle's own readers." ;
            sh:maxCount 1 ;
            sh:node lokf:AudienceShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 33 ;
            sh:path schema1:audience ],
        [ sh:class lokf:Concept ;
            sh:description "An entity this concept was derived from (provenance)." ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:datatype xsd:dateTime ;
            sh:description "ISO 8601 datetime of the last meaningful change." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path schema1:dateModified ],
        [ sh:class lokf:Concept ;
            sh:description "A concept this concept depends on." ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path dcterms:requires ],
        [ sh:description "Lifecycle status of the concept: draft | stable | deprecated. Absent means stable. Advisory, never access control." ;
            sh:in ( "draft" "stable" "deprecated" ) ;
            sh:maxCount 1 ;
            sh:order 30 ;
            sh:path schema1:creativeWorkStatus ],
        [ sh:datatype xsd:dateTime ;
            sh:description "ISO 8601 datetime the concept was created." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path schema1:dateCreated ],
        [ sh:description "The materials this concept derives from, each carrying objective credibility signals. Markdown footnotes join to entries via `sources[].id`. Supersedes `citations` and the body `# Citations` convention." ;
            sh:node lokf:SourceShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 26 ;
            sh:path schema1:isBasedOn ],
        [ sh:datatype xsd:string ;
            sh:description "The markdown body of the concept document (everything after the frontmatter). Mapped to schema:text; carried as a field only in the JSON-LD / JSON serialization, not duplicated in the frontmatter." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path schema1:text ],
        [ sh:datatype xsd:string ;
            sh:description "A single-sentence summary of the concept." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:description ],
        [ sh:description "The Diátaxis documentation mode of the concept's markdown body (tutorial, how-to, reference, or explanation). An optional facet orthogonal to `type`: `type` says what the concept is *about*, `genre` says how its prose *serves the reader*." ;
            sh:in ( "tutorial" "how-to" "reference" "explanation" ) ;
            sh:maxCount 1 ;
            sh:order 25 ;
            sh:path schema1:genre ],
        [ sh:class lokf:Concept ;
            sh:description "A generic association to another concept." ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path dcterms:relation ],
        [ sh:datatype xsd:string ;
            sh:description "The typical age range of the concept's readers, as schema.org writes it: `8-12`, or `13-` for 13 and over." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 34 ;
            sh:path schema1:typicalAgeRange ;
            sh:pattern "^[0-9]{1,3}-([0-9]{1,3})?$" ],
        [ sh:class lokf:Concept ;
            sh:description "A resource from which this concept is derived or sourced." ;
            sh:nodeKind sh:IRI ;
            sh:order 24 ;
            sh:path dcterms:source ] ;
    sh:targetClass lokf:Concept .

lokf:DateParameter rdfs:subClassOf lokf:Parameter .

lokf:DatetimeParameter rdfs:subClassOf lokf:Parameter .

lokf:Document rdfs:subClassOf lokf:Concept .

lokf:ExecutorShape a sh:NodeShape ;
    rdfs:comment "How an Attested Computation is run (OKF v0.2 §10.2): `resource` names run instructions or code a runner follows; `receipt` declares the field names a run must return — the evidence surface the attester inspects. No established vocabulary has an execution-interface class, so the IRI is honestly lokf-minted; schema:EntryPoint (an invocation specification) is the nearest real term." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The field names a run must return (e.g. job_id, executed_sql, result) — the evidence the attester inspects. Receipts themselves are runtime artifacts, never stored in the bundle. Minted in lokf: no established vocabulary describes a receipt-shape declaration." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path lokf:receipt ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Path or URL to the run instructions or code." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:url ] .

lokf:Explanation rdfs:subClassOf lokf:Concept .

lokf:IntegerParameter rdfs:subClassOf lokf:Parameter .

lokf:JsonParameter rdfs:subClassOf lokf:Parameter .

lokf:Metric rdfs:subClassOf lokf:Concept .

lokf:NumberParameter rdfs:subClassOf lokf:Parameter .

lokf:ParameterShape a sh:NodeShape ;
    rdfs:comment "A typed, named hole in an Attested Computation that the agent may fill (OKF v0.2 §10.2). Binding semantics (SQL bind variable, dbt var, Python argument) follow the concept's `runtime`. The `type` key deliberately shares the global JSON-LD @type alias — see the attribute comment for the exact triple that results." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The parameter's name, as the runtime addresses it." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:description "The parameter's datatype, written with the authoring key `type` verbatim and drawn from ParameterType." ;
            sh:in ( lokf:StringParameter lokf:IntegerParameter lokf:NumberParameter lokf:BooleanParameter lokf:DateParameter lokf:DatetimeParameter lokf:TimeParameter lokf:UriParameter lokf:JsonParameter ) ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path rdf:type ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether a value for the parameter must be supplied." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:valueRequired ] .

lokf:Playbook rdfs:subClassOf lokf:Concept .

lokf:Policy rdfs:subClassOf lokf:Concept .

lokf:Reference rdfs:subClassOf lokf:Concept .

lokf:StringParameter rdfs:subClassOf lokf:Parameter .

lokf:Table rdfs:subClassOf schema1:Dataset .

lokf:TimeParameter rdfs:subClassOf lokf:Parameter .

lokf:Tutorial rdfs:subClassOf lokf:Concept .

lokf:UriParameter rdfs:subClassOf lokf:Parameter .

schema1:Dataset rdfs:subClassOf lokf:Concept .

lokf:DistributionShape a sh:NodeShape ;
    rdfs:comment "A specific accessible form of a Dataset (a file, feed, or endpoint). Maps to dcat:Distribution." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A name." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "The media (MIME) type of a distribution." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcat:mediaType ],
        [ sh:datatype xsd:string ;
            sh:description "A single-sentence summary of the concept." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:description ],
        [ sh:datatype xsd:anyURI ;
            sh:description "A URL that gives access to a distribution." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcat:accessURL ] .

lokf:FieldShape a sh:NodeShape ;
    rdfs:comment "A single column / property within a Table or Dataset schema. Maps to schema:PropertyValue." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A name." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text or expression describing constraints on a field." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path lokf:constraints ],
        [ sh:datatype xsd:string ;
            sh:description "A single-sentence summary of the concept." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:description ],
        [ sh:description "The data type of a field." ;
            sh:in ( "string" "integer" "number" "boolean" "date" "datetime" "time" "uri" "json" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path lokf:datatype ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the field is (part of) the primary key." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path lokf:isKey ],
        [ sh:datatype xsd:string ;
            sh:description "The unit of measurement (e.g. USD, seconds, count)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:unitText ] .

lokf:AudienceShape a sh:NodeShape ;
    rdfs:comment "The readers a concept is written for, as schema.org's PeopleAudience describes them: a kind of reader and an age range. Set on a concept written for narrower readers than the bundle's own, such as a version of another concept for younger readers." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "The youngest age, in years, the concept is written for." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:suggestedMinAge ],
        [ sh:datatype xsd:string ;
            sh:description "The kind of reader, in words, such as `students` or `dyslexic readers`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:audienceType ],
        [ sh:datatype xsd:integer ;
            sh:description "The oldest age, in years, the concept is written for." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:suggestedMaxAge ] .

lokf:CitationShape a sh:NodeShape ;
    rdfs:comment "A reference to an external source supporting a claim in a concept's body. Attached via the schema:citation predicate." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Human-readable display name." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:anyURI ;
            sh:description "A URL." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:string ;
            sh:description "A single-sentence summary of the concept." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:description ] .

lokf:GenerationShape a sh:NodeShape ;
    rdfs:comment "How and when the current content was produced (OKF v0.2 `generated`, §5.2). Modeled as the PROV activity that generated the concept, so \"who wrote this, when\" is a one-hop join from the concept via prov:wasGeneratedBy, with both slots keeping PROV's activity-side semantics (prov:wasAssociatedWith, prov:endedAtTime) — domain/range correct with no reasoner or subproperty entailment required." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "ISO 8601 datetime at which the event completed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path prov:endedAtTime ],
        [ sh:datatype xsd:string ;
            sh:description "The state of the resource this event refers to: a commit id, an ETag or version label, or a content digest of the resource as retrieved (`<algorithm>:<hex>`). Absent means unrecorded, never unchanged." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path lokf:revision ],
        [ sh:datatype xsd:string ;
            sh:description "The actor that performed the event, as a plain OKF §7 actor string (`<producer>/<version>`, `human:<id>`, `process:<id>`) — a literal, never an IRI. Trust tiers derive from the `human:` prefix via string inspection (SPARQL STRSTARTS). Required on a generation or verification event." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path prov:wasAssociatedWith ;
            sh:pattern "^(human|process):\\S+$|^[^\\s/]+/[^\\s/]+$" ] .

lokf:RelationShape a sh:NodeShape ;
    rdfs:comment "A typed, reified relationship from the containing concept to a target, used when a predicate is not covered by one of the named relation slots. Modeled as an rdf:Statement (subject = the containing concept)." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class lokf:Concept ;
            sh:description "The IRI (or Concept ID) of the relationship's object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path rdf:object ],
        [ sh:description "The relationship type. SHOULD be drawn from the RelationType vocabulary." ;
            sh:in ( "isPartOf" "hasPart" "references" "dependsOn" "derivedFrom" "isReplacedBy" "wasRevisionOf" "about" "sameAs" "relatedTo" "wasAttributedTo" "definedBy" "measures" "joinsWith" "source" "memberOf" "holder" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path rdf:predicate ],
        [ sh:datatype xsd:string ;
            sh:description "An optional human-readable label for the relationship." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path rdfs:label ] .

lokf:SourceShape a sh:NodeShape ;
    rdfs:comment "A material a concept derives from (OKF v0.2 §5.1) — a pointer (`resource`) plus objective per-source credibility signals (`author`, `usage_count`, `last_modified`) from which consumers infer trust; OKF stores signals, never a score. Markdown footnotes whose label equals `id` attribute individual claims to this entry. Supersedes Citation." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "How often the source's resource was exercised (views, executions, reads) over the governing usage_window. An adoption/liveness signal read as order-of-magnitude and trend, not a score." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path lokf:usageCount ],
        [ sh:description "The `{ from, to }` date range framing every `usage_count`. Attached both to Concept (the shared window, sibling of `sources`) and to Source (a per-entry override)." ;
            sh:maxCount 1 ;
            sh:node lokf:UsageWindowShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path lokf:usageWindow ],
        [ sh:datatype xsd:anyURI ;
            sh:description "REQUIRED. An absolute URL, a bundle-relative path, or a population/scope descriptor string (e.g. \"all queries in BigQuery project X\"). Range is widened to string to admit scope descriptors; non-URI values are lossy on the RDF projection (they serialize as xsd:anyURI-typed literals)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable display name." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the SOURCE itself last changed, an ISO 8601 datetime (a bare YYYY-MM-DD is read as that day at 00:00:00Z). A recency signal about the source, distinct from `generated.at`, which records when this concept's content was produced. Same predicate as the deprecated `timestamp`, on a different subject node (source vs concept)." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path schema1:dateModified ],
        [ sh:datatype xsd:string ;
            sh:description "Optional stable key joining markdown footnote labels to this entry (e.g. `ga4-schema`)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path schema1:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Who or what produced the source, as an actor string (e.g. `team:analytics`, `human:jsmith@acme`, `ga4-docs/v2`) — an authority signal carried as a plain literal, not an inlined Agent object. Deliberately looser than `by`: source authorship is commonly a team or an org, so any `<prefix>:<id>` is admitted, where `by` stays confined to the §7 provenance actors the trust tiers read." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:author ;
            sh:pattern "^[^\\s:/]+:\\S+$|^[^\\s/]+/[^\\s/]+$" ],
        [ sh:datatype xsd:string ;
            sh:description "A verbatim copy of the passage in `resource` that the concept relies on, taken as retrieved. Lets a claim be re-checked against its source without re-reading the whole of it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path lokf:excerpt ] .

lokf:VerificationShape a sh:NodeShape ;
    rdfs:comment "One verification event (OKF v0.2 `verified`, §5.2): an actor confirmed the content against its sources or resource at a time. Independent checks accumulate as separate events; trust tiers (unverified / machine-confirmed / human-reviewed) are derived from the actors, never stored. PROV has no Verification class, so the class IRI is honestly lokf-minted; the generated ontology declares it a subclass of prov:Activity." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The state of the resource this event refers to: a commit id, an ETag or version label, or a content digest of the resource as retrieved (`<algorithm>:<hex>`). Absent means unrecorded, never unchanged." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path lokf:revision ],
        [ sh:datatype xsd:dateTime ;
            sh:description "ISO 8601 datetime at which the event completed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path prov:endedAtTime ],
        [ sh:datatype xsd:string ;
            sh:description "The actor that performed the event, as a plain OKF §7 actor string (`<producer>/<version>`, `human:<id>`, `process:<id>`) — a literal, never an IRI. Trust tiers derive from the `human:` prefix via string inspection (SPARQL STRSTARTS). Required on a generation or verification event." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path prov:wasAssociatedWith ;
            sh:pattern "^(human|process):\\S+$|^[^\\s/]+/[^\\s/]+$" ] .

lokf:AgentShape a sh:NodeShape ;
    rdfs:comment "A person or organization responsible for a concept." ;
    sh:closed false ;
    sh:ignoredProperties ( dcterms:isPartOf dcterms:isReplacedBy dcterms:references dcterms:relation dcterms:requires dcterms:source schema1:about schema1:additionalType schema1:audience schema1:author schema1:citation schema1:creativeWorkStatus schema1:dateCreated schema1:dateModified schema1:description schema1:educationalLevel schema1:expires schema1:genre schema1:hasPart schema1:isBasedOn schema1:keywords schema1:license schema1:sameAs schema1:text schema1:typicalAgeRange schema1:url schema1:version rdf:type rdfs:isDefinedBy prov:wasDerivedFrom prov:wasGeneratedBy lokf:relations lokf:usageWindow lokf:verified ) ;
    sh:property [ sh:description "The concept's type - OKF's single required field. SHOULD name a LOKF class (e.g. Metric, Dataset, Table, Playbook, GlossaryTerm)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path rdf:type ],
        [ sh:description "The concept's stable IRI. By convention it is the bundle base IRI joined with the Concept ID (the file path within the bundle, minus the `.md` suffix). Becomes the JSON-LD @id / RDF subject." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path schema1:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Contact email address." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:email ;
            sh:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ],
        [ sh:datatype xsd:string ;
            sh:description "A name." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:name ] .

lokf:UsageWindowShape a sh:NodeShape ;
    rdfs:comment "The `{ from, to }` date range framing every `usage_count` signal (OKF v0.2 §5.1). Written once as a sibling of `sources`; a single Source entry MAY carry its own override." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "Start (inclusive) of a usage window, an ISO 8601 datetime. A bare YYYY-MM-DD is read as that day at 00:00:00Z." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcat:startDate ],
        [ sh:datatype xsd:dateTime ;
            sh:description "End (inclusive) of a usage window, an ISO 8601 datetime. A bare YYYY-MM-DD is read as that day at 00:00:00Z." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcat:endDate ] .

