@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix lokf: <https://w3id.org/lokf/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

lokf:AttestedComputationShape a sh:NodeShape ;
    rdfs:comment "A sanctioned, immutable recipe for computing a value (OKF v0.2 §10), carried as its own concept type. The frontmatter is the contract: the agent may only bind the declared `parameters`, the `executor` runs the bound computation and returns a receipt, and the `attester` deterministically compares what actually ran against this recipe. The computation text lives in the body's `# Computation` fenced block or in the file named by `computation`. Semantically a prov:Plan with an attestation contract layered on." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:description "Lifecycle status of the concept: draft | stable | deprecated. Absent means stable. Advisory, never access control." ;
            sh:in ( "draft" "stable" "deprecated" ) ;
            sh:maxCount 1 ;
            sh:order 35 ;
            sh:path schema1:creativeWorkStatus ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The absolute instant on or after which the concept is stale (OKF §5.5: stale when now >= stale_after), an ISO 8601 datetime. A bare YYYY-MM-DD is read as that day at 00:00:00Z." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 36 ;
            sh:path schema1:expires ],
        [ sh:datatype xsd:string ;
            sh:description "The typical age range of the concept's readers, as schema.org writes it: `8-12`, or `13-` for 13 and over." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 39 ;
            sh:path schema1:typicalAgeRange ;
            sh:pattern "^[0-9]{1,3}-([0-9]{1,3})?$" ],
        [ sh:class lokf:Concept ;
            sh:description "A concept this concept depends on." ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path dcterms:requires ],
        [ sh:datatype xsd:string ;
            sh:description "A version string for the concept's content." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path schema1:version ],
        [ sh:description "How the computation is run and what evidence a run must return." ;
            sh:maxCount 1 ;
            sh:node lokf:ExecutorShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path lokf:executor ],
        [ sh:datatype xsd:string ;
            sh:description "The markdown body of the concept document (everything after the frontmatter). Mapped to schema:text; carried as a field only in the JSON-LD / JSON serialization, not duplicated in the frontmatter." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path schema1:text ],
        [ sh:description "The concept's type - OKF's single required field. SHOULD name a LOKF class (e.g. Metric, Dataset, Table, Playbook, GlossaryTerm)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path rdf:type ],
        [ sh:description "The Diátaxis documentation mode of the concept's markdown body (tutorial, how-to, reference, or explanation). An optional facet orthogonal to `type`: `type` says what the concept is *about*, `genre` says how its prose *serves the reader*." ;
            sh:in ( "tutorial" "how-to" "reference" "explanation" ) ;
            sh:maxCount 1 ;
            sh:order 30 ;
            sh:path schema1:genre ],
        [ sh:class lokf:Concept ;
            sh:description "An IRI asserting this concept is the same entity as another." ;
            sh:nodeKind sh:IRI ;
            sh:order 26 ;
            sh:path schema1:sameAs ],
        [ sh:class lokf:Concept ;
            sh:description "A generic association to another concept." ;
            sh:nodeKind sh:IRI ;
            sh:order 27 ;
            sh:path dcterms:relation ],
        [ sh:class lokf:Concept ;
            sh:description "The subject matter this concept is about." ;
            sh:nodeKind sh:IRI ;
            sh:order 25 ;
            sh:path schema1:about ],
        [ sh:description "External sources supporting claims in the body." ;
            sh:node lokf:CitationShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path schema1:citation ],
        [ sh:description "How and when the current content was produced: `by` (REQUIRED actor) and `at` (ISO 8601 datetime). Supersedes the v0.1 `timestamp` field; consumers MAY fall back to `timestamp` when `generated` is absent." ;
            sh:maxCount 1 ;
            sh:node lokf:GenerationShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 33 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class lokf:Concept ;
            sh:description "The target concept that this concept is a part of." ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path dcterms:isPartOf ],
        [ sh:datatype xsd:string ;
            sh:description "REQUIRED on an Attested Computation. How to run the computation (bigquery | postgres | dbt | python | Looker | ...); defines what `parameters` mean and how the executor and attester interpret the contract." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:runtimePlatform ],
        [ sh:description "The typed, named holes the agent may fill — the ONLY surface the agent may bind. Binding semantics follow `runtime`." ;
            sh:node lokf:ParameterShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path lokf:parameter ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable display name." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "A single-sentence summary of the concept." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path schema1:description ],
        [ sh:description "Typed relationships whose predicate is not covered by a named relation slot. Each entry is a reified Relation (predicate + target)." ;
            sh:node lokf:RelationShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path lokf:relations ],
        [ sh:description "The materials this concept derives from, each carrying objective credibility signals. Markdown footnotes join to entries via `sources[].id`. Supersedes `citations` and the body `# Citations` convention." ;
            sh:node lokf:SourceShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 31 ;
            sh:path schema1:isBasedOn ],
        [ sh:description "The agent(s) responsible for authoring the concept." ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:node lokf:AgentShape ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 15 ;
            sh:path schema1:author ],
        [ sh:datatype xsd:string ;
            sh:description "The level of education the concept is written for, in words or as the IRI of a level in a published framework, such as a level of ISCED 2011." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 40 ;
            sh:path schema1:educationalLevel ],
        [ sh:datatype xsd:anyURI ;
            sh:description "The license under which the concept or bundle is offered." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path schema1:license ],
        [ sh:datatype xsd:dateTime ;
            sh:description "ISO 8601 datetime the concept was created." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path schema1:dateCreated ],
        [ sh:class lokf:Concept ;
            sh:description "A resource from which this concept is derived or sourced." ;
            sh:nodeKind sh:IRI ;
            sh:order 29 ;
            sh:path dcterms:source ],
        [ sh:description "The readers this concept is written for, such as readers aged 13 to 18, as an inlined Audience. Absent means the bundle's own readers." ;
            sh:maxCount 1 ;
            sh:node lokf:AudienceShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 38 ;
            sh:path schema1:audience ],
        [ sh:datatype xsd:anyURI ;
            sh:description "A URI that uniquely identifies the underlying real-world asset the concept describes (a table console URL, an API base URL, etc.). Absent for purely abstract concepts." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path schema1:url ],
        [ sh:class lokf:Concept ;
            sh:description "A concept that supersedes this one, without asserting equivalence." ;
            sh:nodeKind sh:IRI ;
            sh:order 24 ;
            sh:path dcterms:isReplacedBy ],
        [ sh:description "The `{ from, to }` date range framing every `usage_count`. Attached both to Concept (the shared window, sibling of `sources`) and to Source (a per-entry override)." ;
            sh:maxCount 1 ;
            sh:node lokf:UsageWindowShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 32 ;
            sh:path lokf:usageWindow ],
        [ sh:class lokf:Concept ;
            sh:description "A concept or resource this concept refers to." ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path dcterms:references ],
        [ sh:class lokf:Concept ;
            sh:description "A concept that is a part of this concept." ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path schema1:hasPart ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Optional path to a file holding the computation; absent means the body's `# Computation` fenced block IS the computation. Minted in lokf: schema:contentUrl is the nearest real property but is scoped to MediaObject bytes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path lokf:computation ],
        [ sh:datatype xsd:dateTime ;
            sh:description "ISO 8601 datetime of the last meaningful change." ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path schema1:dateModified ],
        [ sh:datatype xsd:string ;
            sh:description "The producer's own `type` string when it names no LOKF class." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 37 ;
            sh:path schema1:additionalType ],
        [ sh:description "The deterministic, non-LLM verdict check over a receipt." ;
            sh:maxCount 1 ;
            sh:node lokf:AttesterShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path lokf:attester ],
        [ sh:description "The concept's stable IRI. By convention it is the bundle base IRI joined with the Concept ID (the file path within the bundle, minus the `.md` suffix). Becomes the JSON-LD @id / RDF subject." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path schema1:identifier ],
        [ sh:class lokf:Concept ;
            sh:description "A resource that formally defines this concept." ;
            sh:nodeKind sh:IRI ;
            sh:order 28 ;
            sh:path rdfs:isDefinedBy ],
        [ sh:class lokf:Concept ;
            sh:description "An entity this concept was derived from (provenance)." ;
            sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:description "Verification events confirming the content against its sources or resource. Independent of `generated`: who wrote a concept need not be who confirmed it. Trust tiers derive from the actors: absent = unverified; only non-human actors = machine-confirmed; any `human:<id>` actor = human-reviewed." ;
            sh:node lokf:VerificationShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 34 ;
            sh:path lokf:verified ],
        [ sh:datatype xsd:string ;
            sh:description "Short cross-cutting keywords for categorization." ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path schema1:keywords ] ;
    sh:targetClass lokf:AttestedComputation .

lokf:DatasetShape a sh:NodeShape ;
    rdfs:comment "A collection of data, published or curated for access and reuse." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:description "The agent(s) responsible for authoring the concept." ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:node lokf:AgentShape ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 12 ;
            sh:path schema1:author ],
        [ sh:description "The concept's type - OKF's single required field. SHOULD name a LOKF class (e.g. Metric, Dataset, Table, Playbook, GlossaryTerm)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path rdf:type ],
        [ sh:description "Verification events confirming the content against its sources or resource. Independent of `generated`: who wrote a concept need not be who confirmed it. Trust tiers derive from the actors: absent = unverified; only non-human actors = machine-confirmed; any `human:<id>` actor = human-reviewed." ;
            sh:node lokf:VerificationShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 31 ;
            sh:path lokf:verified ],
        [ sh:description "The Diátaxis documentation mode of the concept's markdown body (tutorial, how-to, reference, or explanation). An optional facet orthogonal to `type`: `type` says what the concept is *about*, `genre` says how its prose *serves the reader*." ;
            sh:in ( "tutorial" "how-to" "reference" "explanation" ) ;
            sh:maxCount 1 ;
            sh:order 27 ;
            sh:path schema1:genre ],
        [ sh:datatype xsd:string ;
            sh:description "The markdown body of the concept document (everything after the frontmatter). Mapped to schema:text; carried as a field only in the JSON-LD / JSON serialization, not duplicated in the frontmatter." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path schema1:text ],
        [ sh:class lokf:Concept ;
            sh:description "A concept or resource this concept refers to." ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path dcterms:references ],
        [ sh:class lokf:Concept ;
            sh:description "A resource from which this concept is derived or sourced." ;
            sh:nodeKind sh:IRI ;
            sh:order 26 ;
            sh:path dcterms:source ],
        [ sh:description "The concept's stable IRI. By convention it is the bundle base IRI joined with the Concept ID (the file path within the bundle, minus the `.md` suffix). Becomes the JSON-LD @id / RDF subject." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path schema1:identifier ],
        [ sh:description "The materials this concept derives from, each carrying objective credibility signals. Markdown footnotes join to entries via `sources[].id`. Supersedes `citations` and the body `# Citations` convention." ;
            sh:node lokf:SourceShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 28 ;
            sh:path schema1:isBasedOn ],
        [ sh:description "Typed relationships whose predicate is not covered by a named relation slot. Each entry is a reified Relation (predicate + target)." ;
            sh:node lokf:RelationShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path lokf:relations ],
        [ sh:description "The columns / properties that make up a dataset's schema." ;
            sh:node lokf:FieldShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path lokf:field ],
        [ sh:datatype xsd:anyURI ;
            sh:description "The license under which the concept or bundle is offered." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path schema1:license ],
        [ sh:description "The readers this concept is written for, such as readers aged 13 to 18, as an inlined Audience. Absent means the bundle's own readers." ;
            sh:maxCount 1 ;
            sh:node lokf:AudienceShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 35 ;
            sh:path schema1:audience ],
        [ sh:datatype xsd:dateTime ;
            sh:description "ISO 8601 datetime of the last meaningful change." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path schema1:dateModified ],
        [ sh:class lokf:Concept ;
            sh:description "A generic association to another concept." ;
            sh:nodeKind sh:IRI ;
            sh:order 24 ;
            sh:path dcterms:relation ],
        [ sh:class lokf:Concept ;
            sh:description "A concept that supersedes this one, without asserting equivalence." ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path dcterms:isReplacedBy ],
        [ sh:description "Accessible forms of the dataset." ;
            sh:node lokf:DistributionShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path dcat:distribution ],
        [ sh:datatype xsd:string ;
            sh:description "The typical age range of the concept's readers, as schema.org writes it: `8-12`, or `13-` for 13 and over." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 36 ;
            sh:path schema1:typicalAgeRange ;
            sh:pattern "^[0-9]{1,3}-([0-9]{1,3})?$" ],
        [ sh:description "How and when the current content was produced: `by` (REQUIRED actor) and `at` (ISO 8601 datetime). Supersedes the v0.1 `timestamp` field; consumers MAY fall back to `timestamp` when `generated` is absent." ;
            sh:maxCount 1 ;
            sh:node lokf:GenerationShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 30 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable display name." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path schema1:name ],
        [ sh:class lokf:Concept ;
            sh:description "An IRI asserting this concept is the same entity as another." ;
            sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path schema1:sameAs ],
        [ sh:datatype xsd:dateTime ;
            sh:description "ISO 8601 datetime the concept was created." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path schema1:dateCreated ],
        [ sh:description "Lifecycle status of the concept: draft | stable | deprecated. Absent means stable. Advisory, never access control." ;
            sh:in ( "draft" "stable" "deprecated" ) ;
            sh:maxCount 1 ;
            sh:order 32 ;
            sh:path schema1:creativeWorkStatus ],
        [ sh:class lokf:Concept ;
            sh:description "The target concept that this concept is a part of." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path dcterms:isPartOf ],
        [ sh:class lokf:Concept ;
            sh:description "An entity this concept was derived from (provenance)." ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:description "The `{ from, to }` date range framing every `usage_count`. Attached both to Concept (the shared window, sibling of `sources`) and to Source (a per-entry override)." ;
            sh:maxCount 1 ;
            sh:node lokf:UsageWindowShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 29 ;
            sh:path lokf:usageWindow ],
        [ sh:class lokf:Concept ;
            sh:description "A concept this concept depends on." ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path dcterms:requires ],
        [ sh:datatype xsd:string ;
            sh:description "The level of education the concept is written for, in words or as the IRI of a level in a published framework, such as a level of ISCED 2011." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 37 ;
            sh:path schema1:educationalLevel ],
        [ sh:datatype xsd:string ;
            sh:description "The producer's own `type` string when it names no LOKF class." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 34 ;
            sh:path schema1:additionalType ],
        [ sh:datatype xsd:string ;
            sh:description "Short cross-cutting keywords for categorization." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path schema1:keywords ],
        [ sh:datatype xsd:anyURI ;
            sh:description "A URI that uniquely identifies the underlying real-world asset the concept describes (a table console URL, an API base URL, etc.). Absent for purely abstract concepts." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path schema1:url ],
        [ sh:class lokf:Concept ;
            sh:description "A resource that formally defines this concept." ;
            sh:nodeKind sh:IRI ;
            sh:order 25 ;
            sh:path rdfs:isDefinedBy ],
        [ sh:class lokf:Concept ;
            sh:description "A concept that is a part of this concept." ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path schema1:hasPart ],
        [ sh:class lokf:Concept ;
            sh:description "The subject matter this concept is about." ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path schema1:about ],
        [ sh:datatype xsd:string ;
            sh:description "A single-sentence summary of the concept." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path schema1:description ],
        [ sh:datatype xsd:string ;
            sh:description "A version string for the concept's content." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path schema1:version ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The absolute instant on or after which the concept is stale (OKF §5.5: stale when now >= stale_after), an ISO 8601 datetime. A bare YYYY-MM-DD is read as that day at 00:00:00Z." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 33 ;
            sh:path schema1:expires ],
        [ sh:description "External sources supporting claims in the body." ;
            sh:node lokf:CitationShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path schema1:citation ] ;
    sh:targetClass schema1:Dataset .

lokf:DocumentShape a sh:NodeShape ;
    rdfs:comment "A general knowledge document that does not fit a more specific type." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:description "The license under which the concept or bundle is offered." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path schema1:license ],
        [ sh:description "The `{ from, to }` date range framing every `usage_count`. Attached both to Concept (the shared window, sibling of `sources`) and to Source (a per-entry override)." ;
            sh:maxCount 1 ;
            sh:node lokf:UsageWindowShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 27 ;
            sh:path lokf:usageWindow ],
        [ sh:description "The agent(s) responsible for authoring the concept." ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:node lokf:AgentShape ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 10 ;
            sh:path schema1:author ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable display name." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:name ],
        [ sh:class lokf:Concept ;
            sh:description "A generic association to another concept." ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path dcterms:relation ],
        [ sh:description "Typed relationships whose predicate is not covered by a named relation slot. Each entry is a reified Relation (predicate + target)." ;
            sh:node lokf:RelationShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path lokf:relations ],
        [ sh:description "External sources supporting claims in the body." ;
            sh:node lokf:CitationShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path schema1:citation ],
        [ sh:class lokf:Concept ;
            sh:description "The subject matter this concept is about." ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path schema1:about ],
        [ sh:description "The Diátaxis documentation mode of the concept's markdown body (tutorial, how-to, reference, or explanation). An optional facet orthogonal to `type`: `type` says what the concept is *about*, `genre` says how its prose *serves the reader*." ;
            sh:in ( "tutorial" "how-to" "reference" "explanation" ) ;
            sh:maxCount 1 ;
            sh:order 25 ;
            sh:path schema1:genre ],
        [ sh:class lokf:Concept ;
            sh:description "A resource that formally defines this concept." ;
            sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path rdfs:isDefinedBy ],
        [ sh:description "Verification events confirming the content against its sources or resource. Independent of `generated`: who wrote a concept need not be who confirmed it. Trust tiers derive from the actors: absent = unverified; only non-human actors = machine-confirmed; any `human:<id>` actor = human-reviewed." ;
            sh:node lokf:VerificationShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 29 ;
            sh:path lokf:verified ],
        [ sh:datatype xsd:string ;
            sh:description "A single-sentence summary of the concept." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:description ],
        [ sh:datatype xsd:string ;
            sh:description "A version string for the concept's content." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path schema1:version ],
        [ sh:description "Lifecycle status of the concept: draft | stable | deprecated. Absent means stable. Advisory, never access control." ;
            sh:in ( "draft" "stable" "deprecated" ) ;
            sh:maxCount 1 ;
            sh:order 30 ;
            sh:path schema1:creativeWorkStatus ],
        [ sh:class lokf:Concept ;
            sh:description "A resource from which this concept is derived or sourced." ;
            sh:nodeKind sh:IRI ;
            sh:order 24 ;
            sh:path dcterms:source ],
        [ sh:datatype xsd:string ;
            sh:description "The level of education the concept is written for, in words or as the IRI of a level in a published framework, such as a level of ISCED 2011." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 35 ;
            sh:path schema1:educationalLevel ],
        [ sh:datatype xsd:string ;
            sh:description "The markdown body of the concept document (everything after the frontmatter). Mapped to schema:text; carried as a field only in the JSON-LD / JSON serialization, not duplicated in the frontmatter." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path schema1:text ],
        [ sh:class lokf:Concept ;
            sh:description "A concept or resource this concept refers to." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path dcterms:references ],
        [ sh:class lokf:Concept ;
            sh:description "The target concept that this concept is a part of." ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path dcterms:isPartOf ],
        [ sh:class lokf:Concept ;
            sh:description "A concept this concept depends on." ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path dcterms:requires ],
        [ sh:datatype xsd:string ;
            sh:description "The typical age range of the concept's readers, as schema.org writes it: `8-12`, or `13-` for 13 and over." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 34 ;
            sh:path schema1:typicalAgeRange ;
            sh:pattern "^[0-9]{1,3}-([0-9]{1,3})?$" ],
        [ sh:description "The concept's stable IRI. By convention it is the bundle base IRI joined with the Concept ID (the file path within the bundle, minus the `.md` suffix). Becomes the JSON-LD @id / RDF subject." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path schema1:identifier ],
        [ sh:class lokf:Concept ;
            sh:description "A concept that supersedes this one, without asserting equivalence." ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path dcterms:isReplacedBy ],
        [ sh:description "How and when the current content was produced: `by` (REQUIRED actor) and `at` (ISO 8601 datetime). Supersedes the v0.1 `timestamp` field; consumers MAY fall back to `timestamp` when `generated` is absent." ;
            sh:maxCount 1 ;
            sh:node lokf:GenerationShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 28 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:anyURI ;
            sh:description "A URI that uniquely identifies the underlying real-world asset the concept describes (a table console URL, an API base URL, etc.). Absent for purely abstract concepts." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path schema1:url ],
        [ sh:description "The materials this concept derives from, each carrying objective credibility signals. Markdown footnotes join to entries via `sources[].id`. Supersedes `citations` and the body `# Citations` convention." ;
            sh:node lokf:SourceShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 26 ;
            sh:path schema1:isBasedOn ],
        [ sh:class lokf:Concept ;
            sh:description "An entity this concept was derived from (provenance)." ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:datatype xsd:string ;
            sh:description "Short cross-cutting keywords for categorization." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path schema1:keywords ],
        [ sh:datatype xsd:dateTime ;
            sh:description "ISO 8601 datetime the concept was created." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path schema1:dateCreated ],
        [ sh:description "The concept's type - OKF's single required field. SHOULD name a LOKF class (e.g. Metric, Dataset, Table, Playbook, GlossaryTerm)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path rdf:type ],
        [ sh:class lokf:Concept ;
            sh:description "A concept that is a part of this concept." ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path schema1:hasPart ],
        [ sh:datatype xsd:dateTime ;
            sh:description "ISO 8601 datetime of the last meaningful change." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path schema1:dateModified ],
        [ sh:description "The readers this concept is written for, such as readers aged 13 to 18, as an inlined Audience. Absent means the bundle's own readers." ;
            sh:maxCount 1 ;
            sh:node lokf:AudienceShape ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 33 ;
            sh:path schema1:audience ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The absolute instant on or after which the concept is stale (OKF §5.5: stale when now >= stale_after), an ISO 8601 datetime. A bare YYYY-MM-DD is read as that day at 00:00:00Z." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path schema1:expires ],
        [ sh:class lokf:Concept ;
            sh:description "An IRI asserting this concept is the same entity as another." ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path schema1:sameAs ],
        [ sh:datatype xsd:string ;
            sh:description "The producer's own `type` string when it names no LOKF class." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path schema1:additionalType ] ;
    sh:targetClass lokf:Document .

lokf:ExplanationShape a sh:NodeShape ;
