export LOKF_TOOLKIT_SPEC := env_var_or_default("LOKF_TOOLKIT_SPEC", "lokf[build]==__LOKF_PACKAGE_VERSION__")

# List recipes
default:
    @just --list

# Install the site's dependencies (once; commit package-lock.json)
setup:
    npm install

# Live-preview the site (concept pages + the /graph browser)
dev:
    npm run dev

# Build the static site (output: dist/)
site:
    npm run build

# Interactive SPARQL endpoint + graph explorer over the bundle
serve:
    uvx --from "$LOKF_TOOLKIT_SPEC" lokf serve knowledge

# Project the bundle to RDF (Turtle) on stdout
rdf:
    uvx --from "$LOKF_TOOLKIT_SPEC" lokf convert knowledge --format ttl

# Validate the bundle against its declared schema or the built-in LOKF schema
validate:
    uvx --from "$LOKF_TOOLKIT_SPEC" lokf validate knowledge

# Project the bundle to linked tables (CSV under build/tables)
tables:
    uvx --from 'lokf[tables]==__LOKF_PACKAGE_VERSION__' lokf tables knowledge --format csv --output build/tables
