---
import { LAYOUTS } from '../lib/graph-view.mjs';

interface Props {
  graphSrc: string;
  graphIndexSrc?: string;
  graphDataBase?: string;
  sourceBase?: string;
  communityExclude?: string[];
}

const { graphSrc, graphIndexSrc = '', graphDataBase = '', sourceBase = '', communityExclude = ['isPartOf', 'hasPart'] } = Astro.props;
---

<section
  class="lokf-graph"
  aria-label="Knowledge graph explorer"
  data-graph-src={graphSrc}
  data-index-src={graphIndexSrc}
  data-data-base={graphDataBase}
  data-source-base={sourceBase}
  data-community-exclude={communityExclude.join(',')}
>
  <div class="lokf-graph__controls">
    <div class="lokf-graph__chooser">
      <label for="lokf-graph-concept">Explore a concept</label>
      <input id="lokf-graph-concept" class="lokf-graph__concept" type="search" role="combobox" aria-controls="lokf-graph-choices" aria-expanded="false" autocomplete="off" placeholder="Find a concept by name or ID…" />
      <div id="lokf-graph-choices" class="lokf-graph__choices" role="listbox" hidden></div>
      <button type="button" data-action="show-default">Overview</button>
    </div>
    <div class="lokf-graph__pagination" hidden>
      <button type="button" data-action="previous" disabled>← Previous</button>
      <p class="lokf-graph__status" role="status" aria-live="polite">Loading graph…</p>
      <button type="button" data-action="next" disabled>Next →</button>
    </div>
    <label class="lokf-graph__search-label">Highlight within this view
      <input class="lokf-graph__search" type="search" placeholder="Find a visible concept…" autocomplete="off" />
    </label>
    <div class="lokf-graph__filters">
      <fieldset class="lokf-graph__fieldset" data-filter="type"><legend>Concept types</legend><div class="lokf-graph__filter-items"></div></fieldset>
      <fieldset class="lokf-graph__fieldset" data-filter="predicate"><legend>Relations</legend><div class="lokf-graph__filter-items"></div></fieldset>
    </div>
    <p class="lokf-graph__matches" role="status" aria-live="polite"></p>
  </div>
  <div class="lokf-graph__view-controls" role="group" aria-label="Graph presentation">
    <button type="button" data-view="graph" aria-pressed="true">Graph</button>
    <button type="button" data-view="list" aria-pressed="false">List</button>
    <button type="button" data-action="reset-filters">Reset filters and search</button>
    <button type="button" data-action="share">Copy view link</button>
    <span class="lokf-graph__share-status" role="status" aria-live="polite"></span>
  </div>
  <details class="lokf-graph__group-browser" hidden><summary>Inspect groups and their members</summary><div class="lokf-graph__groups"></div></details>
  <details class="lokf-graph__path">
    <summary>Find a connection path in this view</summary>
    <div class="lokf-graph__path-controls">
      <label>From <select data-path="from"></select></label>
      <label>To <select data-path="to"></select></label>
      <label class="lokf-graph__path-direction"><input type="checkbox" data-path="directed" /> Follow relation direction only</label>
      <button type="button" data-action="find-path">Find path</button>
    </div>
    <div class="lokf-graph__path-result" role="status" aria-live="polite"></div>
  </details>
  <p class="lokf-graph__scope-note">This view shows a bounded neighborhood when the knowledge base is large. Communities are inferred from visible relations. Hub position reflects visible connection counts.</p>
  <section class="lokf-graph__list" aria-label="Concepts in this view" hidden><ul></ul></section>
  <div class="lokf-graph__stage">
    <div class="lokf-graph__toolbar">
      <button type="button" data-action="layouts" aria-expanded="false" aria-controls="lokf-graph-layout-panel">Layout ▾</button>
      <button type="button" data-action="fit">⤢ Fit</button>
      <button type="button" data-action="fullscreen">⛶ Full screen</button>
    </div>
    <div id="lokf-graph-layout-panel" class="lokf-graph__layout-panel" hidden>
      <label for="lokf-graph-layout">Graph layout</label>
      <select id="lokf-graph-layout" class="lokf-graph__layout">
        {Object.entries(LAYOUTS).map(([value, layout]) => <option value={value}>{layout.label}</option>)}
      </select>
      <p class="lokf-graph__layout-help"></p>
      <label class="lokf-graph__edge-label"><input type="checkbox" data-action="edge-labels" /> Show relationship labels</label>
      <button type="button" data-action="rearrange">Rearrange</button>
      <p class="lokf-graph__layout-status" role="status" aria-live="polite"></p>
    </div>
    <div class="lokf-graph__canvas" role="img" aria-label="Interactive concept graph. Use the list view for a keyboard navigable alternative."></div>
    <aside class="lokf-graph__detail" aria-label="Selected concept" hidden>
      <button type="button" class="lokf-graph__close" aria-label="Close concept details">×</button>
      <h3 class="lokf-graph__detail-title"></h3>
      <p class="lokf-graph__detail-description"></p>
      <dl class="lokf-graph__detail-meta"></dl>
      <h4>Connections in this view</h4>
      <ul class="lokf-graph__detail-relations"></ul>
      <div class="lokf-graph__detail-actions"><a class="lokf-graph__detail-page" href="#">Open page →</a><button type="button" data-action="explore">Explore connections</button></div>
    </aside>
  </div>
</section>

<script>
  import { startGraphExplorer } from '../lib/graph-explorer.mjs';
  document.querySelectorAll<HTMLElement>('.lokf-graph').forEach(startGraphExplorer);
</script>

<style is:global>
  .lokf-graph { --graph-text: var(--text, var(--sl-color-text, #253246)); --graph-muted: var(--muted, var(--sl-color-gray-3, #657387)); --graph-bg: var(--surface, var(--sl-color-bg, #fff)); --graph-border: var(--border, var(--sl-color-hairline, #ccd3dc)); --graph-accent: var(--accent, var(--sl-color-accent, #2368a5)); position: relative; margin: 1.5rem 0 2rem; color: var(--graph-text); }
  .lokf-graph button, .lokf-graph input, .lokf-graph select { font: inherit; }
  .lokf-graph button, .lokf-graph select, .lokf-graph input[type=search] { color: var(--graph-text); background: var(--graph-bg); border: 1px solid var(--graph-border); border-radius: .4rem; }
  .lokf-graph button { cursor: pointer; padding: .32rem .6rem; }
  .lokf-graph button:hover, .lokf-graph button:focus-visible { border-color: var(--graph-accent); color: var(--graph-accent); }
  .lokf-graph button:disabled { cursor: default; opacity: .45; }
  .lokf-graph input[type=search], .lokf-graph select { padding: .48rem .65rem; }
  .lokf-graph input:focus-visible, .lokf-graph select:focus-visible, .lokf-graph button:focus-visible, .lokf-graph a:focus-visible { outline: 2px solid var(--graph-accent); outline-offset: 2px; }
  .lokf-graph__controls { display: grid; gap: .65rem; }
  .lokf-graph__chooser { display: grid; grid-template-columns: 1fr auto; gap: .35rem .5rem; position: relative; }
  .lokf-graph__chooser > label { grid-column: 1/-1; font-weight: 650; font-size: .86rem; }
  .lokf-graph__concept { width: 100%; }
  .lokf-graph__choices { position: absolute; left: 0; right: 5rem; top: 100%; z-index: 10; max-height: 16rem; overflow: auto; padding: .25rem; background: var(--graph-bg); border: 1px solid var(--graph-border); border-radius: .4rem; box-shadow: 0 12px 28px #0002; }
  .lokf-graph__choices button { display: block; width: 100%; text-align: left; border: 0; }
  .lokf-graph__choices button small { display: block; color: var(--graph-muted); }
  .lokf-graph__pagination { display: flex; align-items: center; gap: .5rem; }
  .lokf-graph__status { flex: 1; margin: 0; font-size: .82rem; color: var(--graph-muted); text-align: center; }
  .lokf-graph__search-label { display: grid; gap: .3rem; font-size: .84rem; font-weight: 650; }
  .lokf-graph__filters { display: flex; flex-wrap: wrap; gap: .65rem; }
  .lokf-graph__fieldset { flex: 1 1 14rem; min-width: 0; padding: .35rem .7rem .55rem; border: 1px solid var(--graph-border); border-radius: .5rem; background: var(--graph-bg); }
  .lokf-graph__fieldset legend { font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--graph-muted); }
  .lokf-graph__filter-items { display: flex; flex-wrap: wrap; gap: .15rem .8rem; }
  .lokf-graph__filter-items label { display: inline-flex; gap: .25rem; align-items: center; font-size: .8rem; cursor: pointer; }
  .lokf-graph__swatch { width: .65rem; height: .65rem; border-radius: 50%; display: inline-block; }
  .lokf-graph__matches { font-size: .8rem; color: var(--graph-muted); margin: 0; }
  .lokf-graph__view-controls { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem; margin: .65rem 0; }
  .lokf-graph__view-controls [aria-pressed=true] { color: var(--graph-bg); background: var(--graph-accent); border-color: var(--graph-accent); }
  .lokf-graph__share-status { font-size: .8rem; color: var(--graph-muted); }
  .lokf-graph__scope-note { color: var(--graph-muted); font-size: .75rem; margin: .6rem 0; }
  .lokf-graph__group-browser { margin: .45rem 0; font-size: .8rem; }
  .lokf-graph__group-browser summary { cursor: pointer; }
  .lokf-graph__path { margin: .45rem 0; padding: .35rem .6rem; border: 1px solid var(--graph-border); border-radius: .5rem; font-size: .82rem; }
  .lokf-graph__path summary { cursor: pointer; font-weight: 650; }
  .lokf-graph__path-controls { display: flex; flex-wrap: wrap; align-items: end; gap: .5rem; margin: .55rem 0; }
  .lokf-graph__path-controls label { display: grid; gap: .2rem; flex: 1 1 10rem; }
  .lokf-graph__path-controls select { max-width: 100%; }
  .lokf-graph__path-controls .lokf-graph__path-direction { display: flex; align-items: center; flex: 1 1 13rem; }
  .lokf-graph__path-result ol { margin: .4rem 0; padding-left: 1.4rem; }
  .lokf-graph__path-result li { margin: .25rem 0; }
  .lokf-graph__groups { display: flex; flex-wrap: wrap; gap: .7rem; padding: .5rem 0; }
  .lokf-graph__groups section { flex: 1 1 11rem; border: 1px solid var(--graph-border); border-radius: .4rem; padding: .45rem .6rem; }
  .lokf-graph__groups h4 { margin: 0 0 .2rem; }
  .lokf-graph__groups ul { margin: .2rem 0; padding-left: 1rem; }
  .lokf-graph__list { border: 1px solid var(--graph-border); border-radius: .5rem; max-height: 68vh; overflow: auto; background: var(--graph-bg); }
  .lokf-graph__list ul { margin: 0; padding: .3rem; list-style: none; }
  .lokf-graph__list li { border-bottom: 1px solid var(--graph-border); }
  .lokf-graph__list li:last-child { border: 0; }
  .lokf-graph__list button { width: 100%; text-align: left; border: 0; padding: .5rem .65rem; }
  .lokf-graph__list small { display: block; color: var(--graph-muted); }
  .lokf-graph__stage { position: relative; }
  .lokf-graph__toolbar { position: absolute; top: .55rem; left: .55rem; z-index: 3; display: flex; flex-wrap: wrap; gap: .35rem; }
  .lokf-graph__toolbar button, .lokf-graph__layout-panel button { font-size: .75rem; }
  .lokf-graph__layout-panel { position: absolute; top: 2.9rem; left: .55rem; z-index: 5; width: min(20rem, calc(100% - 1rem)); padding: .75rem; background: var(--graph-bg); border: 1px solid var(--graph-border); border-radius: .5rem; box-shadow: 0 12px 28px #0002; }
  .lokf-graph__layout-panel > label:first-child { display: block; font-weight: 650; font-size: .8rem; }
  .lokf-graph__layout-panel select { width: 100%; margin: .3rem 0; }
  .lokf-graph__layout-panel p { margin: .35rem 0; font-size: .78rem; color: var(--graph-muted); }
  .lokf-graph__edge-label { display: block; font-size: .8rem; margin: .5rem 0; }
  .lokf-graph__canvas { width: 100%; height: 62vh; min-height: 460px; border: 1px solid var(--graph-border); border-radius: .5rem; background: radial-gradient(circle at 25% 15%, color-mix(in srgb, var(--graph-accent) 5%, transparent), transparent 55%), var(--graph-bg); }
  .lokf-graph__stage:fullscreen { background: var(--graph-bg); }
  .lokf-graph__stage:fullscreen .lokf-graph__canvas { height: 100vh; min-height: 100vh; border: 0; }
  .lokf-graph__detail { position: absolute; top: .6rem; right: .6rem; z-index: 4; width: min(22rem, calc(100% - 1.2rem)); max-height: calc(100% - 1.2rem); overflow: auto; padding: .8rem .95rem; background: var(--graph-bg); border: 1px solid var(--graph-border); border-radius: .5rem; box-shadow: 0 12px 30px #0003; font-size: .82rem; }
  .lokf-graph__detail h3 { margin: 0 1.4rem .3rem 0; font-size: 1rem; }
  .lokf-graph__detail h4 { margin: .65rem 0 .2rem; font-size: .82rem; }
  .lokf-graph__detail-description { margin: .3rem 0; }
  .lokf-graph__detail-meta { display: grid; grid-template-columns: auto 1fr; gap: .12rem .55rem; margin: .4rem 0; }
  .lokf-graph__detail-meta dt { font-weight: 700; color: var(--graph-muted); }
  .lokf-graph__detail-meta dd { margin: 0; overflow-wrap: anywhere; }
  .lokf-graph__detail-relations { padding-left: 1rem; max-height: 10rem; overflow: auto; margin: .3rem 0; }
  .lokf-graph__detail-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; }
  .lokf-graph__detail-page { color: var(--graph-accent); }
  .lokf-graph__close { position: absolute; top: .2rem; right: .4rem; font-size: 1.25rem; border: 0 !important; }
  .lokf-graph [hidden] { display: none !important; }
  .lokf-graph[data-view=list] .lokf-graph__canvas, .lokf-graph[data-view=list] .lokf-graph__toolbar, .lokf-graph[data-view=list] .lokf-graph__layout-panel { display: none; }
  .lokf-graph[data-view=list] .lokf-graph__detail { position: relative; top: auto; right: auto; width: 100%; max-height: none; margin-top: .5rem; box-shadow: none; }
  @media (max-width: 600px) { .lokf-graph__pagination { flex-wrap: wrap; } .lokf-graph__status { flex-basis: 100%; order: -1; } .lokf-graph__canvas { min-height: 380px; } .lokf-graph__detail { top: 3rem; } }
</style>
