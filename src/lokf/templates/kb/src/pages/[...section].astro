---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

/**
 * A section's `index.md` (OKF §3) is its authored guide, as the root one is
 * the home page's. Each is published at its directory's address, unless a
 * concept already has that address. Read as Markdown modules, not a content
 * collection, so a bundle without sections builds without warnings.
 */
export async function getStaticPaths() {
  const concepts = new Set((await getCollection('knowledge')).map((entry) => entry.id));
  const guides = import.meta.glob<any>('/knowledge/**/index.md', { eager: true });
  return Object.entries(guides)
    .map(([file, guide]) => ({ section: file.replace(/^\/knowledge\//, '').replace(/\/?index\.md$/, ''), guide }))
    .filter(({ section }) => section && !concepts.has(section))
    .map(({ section, guide }) => ({ params: { section }, props: { section, guide } }));
}

const { section, guide } = Astro.props;
const { Content } = guide;
// The body's leading `# Heading` names the section; the layout prints it
const heading = /^\s*#[ \t]+(.+)/.exec(guide.rawContent?.() ?? '')?.[1]?.trim();
const last = section.split('/').at(-1) ?? section;
const title = guide.frontmatter?.title ?? heading ?? last.replace(/[-_]+/g, ' ').replace(/^./, (c: string) => c.toUpperCase());
---

<Base title={`${title} — __KB_TITLE__`} description={guide.frontmatter?.description ?? `${title}, a section of __KB_TITLE__.`}>
  <h1>{title}</h1>
  <article class="editorial"><Content /></article>
</Base>
