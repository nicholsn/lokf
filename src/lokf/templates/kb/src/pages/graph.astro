---
import Base from '../layouts/Base.astro';
import GraphExplorer from '../components/GraphExplorer.astro';
import { href } from '../lib/lokf';
---

<Base title="Knowledge graph — __KB_TITLE__" description="Explore concepts and typed relationships in this knowledge base." wide>
  <h1>Knowledge graph</h1>
  <p class="tagline">Choose a concept, follow its connections, or switch layouts to see a different view.
    Raw data: <a href={href('/graph.json')}><code>graph.json</code></a> ·
    <a href={href('/graph.jsonld')}><code>graph.jsonld</code></a>.
  </p>
  <GraphExplorer graphSrc={href('/graph.json')} graphIndexSrc={href('/graph-index.json')} graphDataBase={href('/graph-data/')} />
</Base>
