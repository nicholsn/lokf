---
import { getCollection } from 'astro:content';
import ConceptPage from '../components/ConceptPage.astro';
import ViewPage from '../components/ViewPage.astro';
import { checkViewRoutes, loadViews } from '../lib/view-data';
import type { Concept } from '../lib/lokf';

export async function getStaticPaths() {
  const [concepts, navigation] = await Promise.all([getCollection('knowledge'), loadViews()]);
  checkViewRoutes(navigation, concepts);
  return [
    ...concepts.map(entry => ({ params: { slug: entry.id }, props: { entry } })),
    ...Array.from(navigation.pages.keys(), path => ({ params: { slug: path }, props: { path } })),
  ];
}

interface Props { entry?: Concept; path?: string }
const { entry, path } = Astro.props;
const navigation = await loadViews();
const info = path && navigation.pages.get(path);
if (!entry && !info) throw new Error(`Unknown view route: ${Astro.params.slug}`);
---
{entry ? <ConceptPage {entry} {navigation} /> : info && <ViewPage {info} records={navigation.records} />}
