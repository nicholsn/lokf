        [ sh:class lokf:Concept ;
            sh:description "A concept this concept depends on." ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path dcterms:requires ],
        [ sh:class rdf:Statement ;
            sh:description "Typed relationships whose predicate is not covered by a named relation slot. Each entry is a reified Relation (predicate + target)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path lokf:relations ],
        [ sh:class lokf:Concept ;
            sh:description "A concept that is a part of this concept." ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path schema1:hasPart ],
        [ sh:class schema1:CreativeWork ;
            sh:description "The materials this concept derives from, each carrying objective credibility signals. Markdown footnotes join to entries via `sources[].id`. Supersedes `citations` and the body `# Citations` convention." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 27 ;
            sh:path schema1:isBasedOn ],
        [ sh:class lokf:Verification ;
            sh:description "Verification events confirming the content against its sources or resource. Independent of `generated`: who wrote a concept need not be who confirmed it. Trust tiers derive from the actors: absent = unverified; only non-human actors = machine-confirmed; any `human:<id>` actor = human-reviewed. A bare `{ by, at }` mapping MUST be read as a one-element list; the LOKF loader normalizes the bare form before LinkML validation. Minted in lokf: no established vocabulary has an entity-to-verification-event property." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 30 ;
            sh:path lokf:verified ],
        [ sh:class schema1:PropertyValue ;
            sh:description "The columns / properties that make up a dataset's schema." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path lokf:field ],
        [ sh:class lokf:Concept ;
            sh:description "The subject matter this concept is about." ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path schema1:about ],
        [ sh:description "Lifecycle status of the concept: draft | stable | deprecated. Absent means stable (consumer-side default; absence is deliberately distinguishable from an explicit `status: stable`, so no ifabsent). Advisory, never access control." ;
            sh:in ( adms_status:UnderDevelopment adms_status:Completed adms_status:Deprecated ) ;
            sh:maxCount 1 ;
            sh:order 31 ;
            sh:path schema1:creativeWorkStatus ],
        [ sh:class prov:Activity ;
            sh:description "How and when the current content was produced: `by` (REQUIRED actor) and `at` (ISO 8601 datetime). Supersedes the v0.1 `timestamp` field; consumers MAY fall back to `timestamp` when `generated` is absent." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 29 ;
            sh:path prov:wasGeneratedBy ] ;
    sh:targetClass lokf:Table .

lokf:Tutorial a sh:NodeShape ;
    rdfs:comment "A learning-oriented lesson: a guided, end-to-end practical activity through which a reader acquires a skill by doing. The Diátaxis tutorial mode as a first-class concept type; typically links to the reference and explanation it draws on with `references`." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Lifecycle status of the concept: draft | stable | deprecated. Absent means stable (consumer-side default; absence is deliberately distinguishable from an explicit `status: stable`, so no ifabsent). Advisory, never access control." ;
            sh:in ( adms_status:UnderDevelopment adms_status:Completed adms_status:Deprecated ) ;
            sh:maxCount 1 ;
            sh:order 29 ;
            sh:path schema1:creativeWorkStatus ],
        [ sh:datatype xsd:dateTime ;
            sh:description "ISO 8601 datetime of the last meaningful change." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path schema1:dateModified ],
        [ sh:description "The concept's stable IRI. By convention it is the bundle base IRI joined with the Concept ID (the file path within the bundle, minus the `.md` suffix). Becomes the JSON-LD @id / RDF subject." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path schema1:identifier ],
        [ sh:class lokf:Concept ;
            sh:description "A resource that formally defines this concept." ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path rdfs:isDefinedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "ISO 8601 datetime the concept was created." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path schema1:dateCreated ],
        [ sh:datatype xsd:string ;
            sh:description "A single-sentence summary of the concept." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:description ],
        [ sh:description "A URI that uniquely identifies the underlying real-world asset the concept describes (a table console URL, an API base URL, etc.). Absent for purely abstract concepts." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path schema1:url ],
        [ sh:class dcterms:PeriodOfTime ;
            sh:description "The `{ from, to }` date range framing every `usage_count`. Attached both to Concept (the shared window, sibling of `sources`) and to Source (a per-entry override)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 26 ;
            sh:path lokf:usageWindow ],
        [ sh:datatype xsd:date ;
            sh:description "Absolute date (YYYY-MM-DD) on or after which the concept is stale (stale when today >= stale_after). schema:expires is the exact concept — a planned future expiry; prov:invalidatedAtTime would falsely assert the entity WAS invalidated, and dcterms:valid names a validity period only ambiguously." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path schema1:expires ],
        [ sh:datatype xsd:string ;
            sh:description "A version string for the concept's content." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path schema1:version ],
        [ sh:class schema1:CreativeWork ;
            sh:description "The materials this concept derives from, each carrying objective credibility signals. Markdown footnotes join to entries via `sources[].id`. Supersedes `citations` and the body `# Citations` convention." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 25 ;
            sh:path schema1:isBasedOn ],
        [ sh:class lokf:Concept ;
            sh:description "A concept this concept depends on." ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path dcterms:requires ],
        [ sh:description "The license under which the concept or bundle is offered." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path schema1:license ],
        [ sh:class lokf:Verification ;
            sh:description "Verification events confirming the content against its sources or resource. Independent of `generated`: who wrote a concept need not be who confirmed it. Trust tiers derive from the actors: absent = unverified; only non-human actors = machine-confirmed; any `human:<id>` actor = human-reviewed. A bare `{ by, at }` mapping MUST be read as a one-element list; the LOKF loader normalizes the bare form before LinkML validation. Minted in lokf: no established vocabulary has an entity-to-verification-event property." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 28 ;
            sh:path lokf:verified ],
        [ sh:class lokf:Concept ;
            sh:description "A concept or resource this concept refers to." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path dcterms:references ],
        [ sh:class lokf:Concept ;
            sh:description "An entity this concept was derived from (provenance)." ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:datatype xsd:string ;
            sh:description "The markdown body of the concept document (everything after the frontmatter). Mapped to schema:text; carried as a field only in the JSON-LD / JSON serialization, not duplicated in the frontmatter." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path schema1:text ],
        [ sh:class lokf:Concept ;
            sh:description "The target concept that this concept is a part of." ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path dcterms:isPartOf ],
        [ sh:class schema1:CreativeWork ;
            sh:description "External sources supporting claims in the body." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path schema1:citation ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable display name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:name ],
        [ sh:class prov:Agent ;
            sh:description "The agent(s) responsible for authoring the concept." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path schema1:author ],
        [ sh:class rdf:Statement ;
            sh:description "Typed relationships whose predicate is not covered by a named relation slot. Each entry is a reified Relation (predicate + target)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path lokf:relations ],
        [ sh:class lokf:Concept ;
            sh:description "A resource from which this concept is derived or sourced." ;
            sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path dcterms:source ],
        [ sh:class lokf:Concept ;
            sh:description "A concept that is a part of this concept." ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path schema1:hasPart ],
        [ sh:datatype xsd:string ;
            sh:description "Short cross-cutting keywords for categorization." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path schema1:keywords ],
        [ sh:class lokf:Concept ;
            sh:description "A generic association to another concept." ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path dcterms:relation ],
        [ sh:datatype xsd:string ;
            sh:description "The concept's type. OKF's single required field. In LOKF the value SHOULD name a LOKF class (e.g. Metric, Dataset, Table, Playbook, GlossaryTerm); it designates the JSON-LD @type / rdf:type. Consumers MUST tolerate unknown values by treating the concept as a generic lokf:Concept." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path lokf:type ],
        [ sh:class lokf:Concept ;
            sh:description "An IRI asserting this concept is the same entity as another." ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path schema1:sameAs ],
        [ sh:class prov:Activity ;
            sh:description "How and when the current content was produced: `by` (REQUIRED actor) and `at` (ISO 8601 datetime). Supersedes the v0.1 `timestamp` field; consumers MAY fall back to `timestamp` when `generated` is absent." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 27 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:description "The Diátaxis documentation mode of the concept's markdown body (tutorial, how-to, reference, or explanation). An optional facet that is orthogonal to `type`: `type` says what the concept is *about*, `genre` says how its prose *serves the reader*. Consumers MUST tolerate absent or unknown values." ;
            sh:in ( schema1:LearningResource schema1:HowTo schema1:APIReference schema1:Article ) ;
            sh:maxCount 1 ;
            sh:order 24 ;
            sh:path schema1:genre ],
        [ sh:class lokf:Concept ;
            sh:description "The subject matter this concept is about." ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path schema1:about ] ;
    sh:targetClass lokf:Tutorial .

lokf:Attester a sh:NodeShape ;
    rdfs:comment "The deterministic, non-LLM check for an Attested Computation (OKF v0.2 §10.2): `resource` names code that takes a run's receipt and returns a verdict, run consumer-side. Honestly lokf-minted." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Path or URL to the deterministic verdict code." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path schema1:url ] ;
    sh:targetClass lokf:Attester .

lokf:Executor a sh:NodeShape ;
    rdfs:comment "How an Attested Computation is run (OKF v0.2 §10.2): `resource` names run instructions or code a runner follows; `receipt` declares the field names a run must return — the evidence surface the attester inspects. No established vocabulary has an execution-interface class, so the IRI is honestly lokf-minted; schema:EntryPoint (an invocation specification) is the nearest real term." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The field names a run must return (e.g. job_id, executed_sql, result) — the evidence the attester inspects. Receipts themselves are runtime artifacts, never stored in the bundle. Minted in lokf: no established vocabulary describes a receipt-shape declaration." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path lokf:receipt ],
        [ sh:description "Path or URL to the run instructions or code." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path schema1:url ] ;
    sh:targetClass lokf:Executor .

lokf:Parameter a sh:NodeShape ;
    rdfs:comment "A typed, named hole in an Attested Computation that the agent may fill (OKF v0.2 §10.2). Binding semantics (SQL bind variable, dbt var, Python argument) follow the concept's `runtime`. The `type` key deliberately shares the global JSON-LD @type alias — see the attribute comment for the exact triple that results." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Whether a value for the parameter must be supplied." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:valueRequired ],
        [ sh:datatype xsd:string ;
            sh:description "The parameter's name, as the runtime addresses it." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:description "The parameter's datatype, written with the authoring key `type` verbatim and drawn from ParameterType. Declared as a class-local attribute rather than slot_usage over the global type slot, because LinkML's falsy-merge silently drops a `designates_type: false` override and gen-python then hard-fails. Because the flat context aliases `type` to @type, the value expands as the node's rdf:type; every ParameterType value therefore means a designed lokf Parameter-kind class, so `type: integer` yields the true, OWL-DL-safe triple `_:p rdf:type lokf:IntegerParameter`. slot_uri rdf:type makes the LinkML RDF-dump path emit the same triple (enum meanings expand to their IRIs)." ;
            sh:in ( lokf:StringParameter lokf:IntegerParameter lokf:NumberParameter lokf:BooleanParameter lokf:DateParameter lokf:DatetimeParameter lokf:TimeParameter lokf:UriParameter lokf:JsonParameter ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path rdf:type ] ;
    sh:targetClass lokf:Parameter .

schema1:PropertyValue a sh:NodeShape ;
    rdfs:comment "A single column / property within a Table or Dataset schema. Maps to schema:PropertyValue." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Whether the field is (part of) the primary key." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path lokf:isKey ],
        [ sh:datatype xsd:string ;
            sh:description "A single-sentence summary of the concept." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:description ],
        [ sh:datatype xsd:string ;
            sh:description "A name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text or expression describing constraints on a field." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path lokf:constraints ],
        [ sh:datatype xsd:string ;
            sh:description "The unit of measurement (e.g. USD, seconds, count)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:unitText ],
        [ sh:description "The data type of a field." ;
            sh:in ( xsd:string xsd:integer xsd:decimal xsd:boolean xsd:date xsd:dateTime xsd:time xsd:anyURI rdf:JSON ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path lokf:datatype ] ;
    sh:targetClass schema1:PropertyValue .

dcat:Distribution a sh:NodeShape ;
    rdfs:comment "A specific accessible form of a Dataset (a file, feed, or endpoint). Maps to dcat:Distribution." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A single-sentence summary of the concept." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:description ],
        [ sh:datatype xsd:string ;
            sh:description "The media (MIME) type of a distribution." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcat:mediaType ],
        [ sh:description "A URL that gives access to a distribution." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dcat:accessURL ],
        [ sh:datatype xsd:string ;
            sh:description "A name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ] ;
    sh:targetClass dcat:Distribution .

rdf:Statement a sh:NodeShape ;
    rdfs:comment "A typed, reified relationship from the containing concept to a target, used when a predicate is not covered by one of the named relation slots. Modeled as an rdf:Statement (subject = the containing concept)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "An optional human-readable label for the relationship." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path rdfs:label ],
        [ sh:description "The relationship type. SHOULD be drawn from the RelationType vocabulary." ;
            sh:in ( dcterms:isPartOf schema1:hasPart dcterms:references dcterms:requires prov:wasDerivedFrom schema1:about owl:sameAs dcterms:relation prov:wasAttributedTo rdfs:isDefinedBy lokf:measures lokf:joinsWith dcterms:source schema1:memberOf org:member ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path rdf:predicate ],
        [ sh:class lokf:Concept ;
            sh:description "The IRI (or Concept ID) of the relationship's object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path rdf:object ] ;
    sh:targetClass rdf:Statement .

prov:Activity a sh:NodeShape ;
    rdfs:comment "How and when the current content was produced (OKF v0.2 `generated`, §5.2). Modeled as the PROV activity that generated the concept, so \"who wrote this, when\" is a one-hop join from the concept via prov:wasGeneratedBy, with both slots keeping PROV's activity-side semantics (prov:wasAssociatedWith, prov:endedAtTime) — domain/range correct with no reasoner or subproperty entailment required." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "ISO 8601 datetime at which the event completed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path prov:endedAtTime ],
        [ sh:datatype xsd:string ;
            sh:description "The actor that performed the event, as a plain OKF §7 actor string (`<producer>/<version>`, `human:<id>`, `process:<id>`) — a literal, never an IRI. Trust tiers derive from the `human:` prefix via string inspection (SPARQL STRSTARTS)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path prov:wasAssociatedWith ] ;
    sh:targetClass prov:Activity .

lokf:Verification a sh:NodeShape ;
    rdfs:comment "One verification event (OKF v0.2 `verified`, §5.2): an actor confirmed the content against its sources or resource at a time. Independent checks accumulate as separate events; trust tiers (unverified / machine-confirmed / human-reviewed) are derived from the actors, never stored. PROV has no Verification class, so the class IRI is honestly lokf-minted; the generated ontology declares it a subclass of prov:Activity." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The actor that performed the event, as a plain OKF §7 actor string (`<producer>/<version>`, `human:<id>`, `process:<id>`) — a literal, never an IRI. Trust tiers derive from the `human:` prefix via string inspection (SPARQL STRSTARTS)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:datatype xsd:dateTime ;
            sh:description "ISO 8601 datetime at which the event completed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path prov:endedAtTime ] ;
    sh:targetClass lokf:Verification .

dcterms:PeriodOfTime a sh:NodeShape ;
    rdfs:comment "The `{ from, to }` date range framing every `usage_count` signal (OKF v0.2 §5.1). Written once as a sibling of `sources`; a single Source entry MAY carry its own override." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:date ;
            sh:description "Start date (inclusive, YYYY-MM-DD) of a usage window." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcat:startDate ],
        [ sh:datatype xsd:date ;
            sh:description "End date (inclusive, YYYY-MM-DD) of a usage window." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcat:endDate ] ;
    sh:targetClass dcterms:PeriodOfTime .

prov:Agent a sh:NodeShape ;
    rdfs:comment "A person or organization responsible for a concept." ;
    sh:closed false ;
    sh:ignoredProperties ( dcterms:source schema1:author schema1:dateModified lokf:usageWindow lokf:relations rdf:type schema1:license prov:wasGeneratedBy schema1:isBasedOn schema1:text schema1:creativeWorkStatus schema1:about schema1:url schema1:keywords dcterms:isPartOf schema1:genre schema1:description schema1:citation dcterms:relation rdfs:isDefinedBy schema1:sameAs lokf:verified schema1:hasPart schema1:dateCreated dcterms:references prov:wasDerivedFrom dcterms:requires schema1:version schema1:expires ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:name ],
        [ sh:description "The concept's stable IRI. By convention it is the bundle base IRI joined with the Concept ID (the file path within the bundle, minus the `.md` suffix). Becomes the JSON-LD @id / RDF subject." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path schema1:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Contact email address." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:email ],
        [ sh:datatype xsd:string ;
            sh:description "The concept's type. OKF's single required field. In LOKF the value SHOULD name a LOKF class (e.g. Metric, Dataset, Table, Playbook, GlossaryTerm); it designates the JSON-LD @type / rdf:type. Consumers MUST tolerate unknown values by treating the concept as a generic lokf:Concept." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path lokf:type ] ;
    sh:targetClass prov:Agent .

schema1:CreativeWork a sh:NodeShape ;
    rdfs:comment "A material a concept derives from (OKF v0.2 §5.1) — a pointer (`resource`) plus objective per-source credibility signals (`author`, `usage_count`, `last_modified`) from which consumers infer trust; OKF stores signals, never a score. Markdown footnotes whose label equals `id` attribute individual claims to this entry. Supersedes Citation.",
        "A reference to an external source supporting a claim in a concept's body. Attached via the schema:citation predicate." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ),
        ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Human-readable display name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:date ;
            sh:description "When the SOURCE itself last changed (YYYY-MM-DD). A recency signal about the source, distinct from `generated.at`, which records when this concept's content was produced. Same predicate as the deprecated `timestamp`, on a different subject node (source vs concept)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path schema1:dateModified ],
        [ sh:datatype xsd:string ;
            sh:description "Who or what produced the source, as an OKF §7 actor string (e.g. `team:ga4-docs`) — an authority signal carried as a plain literal, not an inlined Agent object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:author ],
        [ sh:datatype xsd:string ;
            sh:description "Optional stable key joining markdown footnote labels to this entry (e.g. `ga4-schema`). Declared as a class-local attribute rather than the global identifier slot so it stays optional (LinkML's falsy-merge silently drops an `identifier: false` slot_usage override and generation then fails). Under the published flat context `id` maps to @id, so the value resolves against the bundle base and mints the source node's IRI — the same id used across concepts merges into one RDF node; schema:identifier applies only on the LinkML RDF-dump path." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path schema1:identifier ],
        [ sh:datatype xsd:integer ;
            sh:description "How often the source's resource was exercised (views, executions, reads) over the governing usage_window. An adoption/liveness signal read as order-of-magnitude and trend, not a score. Minted in lokf: no established vocabulary has a bare-integer usage property (schema:userInteractionCount is domained to the InteractionCounter reification)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path lokf:usageCount ],
        [ sh:datatype xsd:string ;
            sh:description "REQUIRED. An absolute URL, a bundle-relative path, or a population/scope descriptor string (e.g. \"all queries in BigQuery project X\"). Range is widened to string to admit scope descriptors; non-URI values are lossy on the RDF projection (they serialize as xsd:anyURI-typed literals)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:string ;
            sh:description "A single-sentence summary of the concept." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:description ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable display name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:name ],
        [ sh:class dcterms:PeriodOfTime ;
            sh:description "The `{ from, to }` date range framing every `usage_count`. Attached both to Concept (the shared window, sibling of `sources`) and to Source (a per-entry override)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path lokf:usageWindow ],
        [ sh:description "A URL." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path schema1:url ] ;
    sh:targetClass schema1:CreativeWork .

lokf:Concept a sh:NodeShape ;
    rdfs:comment "A single unit of knowledge within a bundle, represented as one markdown document. The abstract base of every LOKF type. Its own IRI (`id`) is the RDF subject; the markdown body and typed relations become triples about that subject." ;
    sh:closed false ;
    sh:ignoredProperties ( dcat:distribution lokf:executor schema1:alternateName schema1:startDate lokf:measures schema1:unitText schema1:documentation lokf:attester schema1:memberOf rdf:type org:member lokf:parameter schema1:endDate schema1:runtimePlatform skos:definition lokf:formula lokf:computation lokf:field schema1:roleName schema1:httpMethod ) ;
    sh:property [ sh:description "The license under which the concept or bundle is offered." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path schema1:license ],
        [ sh:class lokf:Concept ;
            sh:description "A concept or resource this concept refers to." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path dcterms:references ],
        [ sh:datatype xsd:dateTime ;
            sh:description "ISO 8601 datetime the concept was created." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path schema1:dateCreated ],
        [ sh:datatype xsd:dateTime ;
            sh:description "ISO 8601 datetime of the last meaningful change." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path schema1:dateModified ],
        [ sh:class rdf:Statement ;
            sh:description "Typed relationships whose predicate is not covered by a named relation slot. Each entry is a reified Relation (predicate + target)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path lokf:relations ],
        [ sh:class lokf:Concept ;
            sh:description "An IRI asserting this concept is the same entity as another." ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path schema1:sameAs ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable display name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:name ],
        [ sh:class lokf:Concept ;
            sh:description "A concept this concept depends on." ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path dcterms:requires ],
        [ sh:class lokf:Concept ;
            sh:description "A resource that formally defines this concept." ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path rdfs:isDefinedBy ],
        [ sh:class lokf:Concept ;
            sh:description "An entity this concept was derived from (provenance)." ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:class lokf:Verification ;
            sh:description "Verification events confirming the content against its sources or resource. Independent of `generated`: who wrote a concept need not be who confirmed it. Trust tiers derive from the actors: absent = unverified; only non-human actors = machine-confirmed; any `human:<id>` actor = human-reviewed. A bare `{ by, at }` mapping MUST be read as a one-element list; the LOKF loader normalizes the bare form before LinkML validation. Minted in lokf: no established vocabulary has an entity-to-verification-event property." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 28 ;
            sh:path lokf:verified ],
        [ sh:description "The concept's stable IRI. By convention it is the bundle base IRI joined with the Concept ID (the file path within the bundle, minus the `.md` suffix). Becomes the JSON-LD @id / RDF subject." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path schema1:identifier ],
        [ sh:class prov:Agent ;
            sh:description "The agent(s) responsible for authoring the concept." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path schema1:author ],
        [ sh:datatype xsd:string ;
            sh:description "A version string for the concept's content." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path schema1:version ],
        [ sh:datatype xsd:string ;
            sh:description "The markdown body of the concept document (everything after the frontmatter). Mapped to schema:text; carried as a field only in the JSON-LD / JSON serialization, not duplicated in the frontmatter." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path schema1:text ],
        [ sh:class lokf:Concept ;
            sh:description "A resource from which this concept is derived or sourced." ;
            sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path dcterms:source ],
        [ sh:class prov:Activity ;
            sh:description "How and when the current content was produced: `by` (REQUIRED actor) and `at` (ISO 8601 datetime). Supersedes the v0.1 `timestamp` field; consumers MAY fall back to `timestamp` when `generated` is absent." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 27 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class lokf:Concept ;
            sh:description "A generic association to another concept." ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path dcterms:relation ],
        [ sh:description "Lifecycle status of the concept: draft | stable | deprecated. Absent means stable (consumer-side default; absence is deliberately distinguishable from an explicit `status: stable`, so no ifabsent). Advisory, never access control." ;
            sh:in ( adms_status:UnderDevelopment adms_status:Completed adms_status:Deprecated ) ;
            sh:maxCount 1 ;
            sh:order 29 ;
            sh:path schema1:creativeWorkStatus ],
        [ sh:class schema1:CreativeWork ;
            sh:description "The materials this concept derives from, each carrying objective credibility signals. Markdown footnotes join to entries via `sources[].id`. Supersedes `citations` and the body `# Citations` convention." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 25 ;
            sh:path schema1:isBasedOn ],
        [ sh:description "The Diátaxis documentation mode of the concept's markdown body (tutorial, how-to, reference, or explanation). An optional facet that is orthogonal to `type`: `type` says what the concept is *about*, `genre` says how its prose *serves the reader*. Consumers MUST tolerate absent or unknown values." ;
            sh:in ( schema1:LearningResource schema1:HowTo schema1:APIReference schema1:Article ) ;
            sh:maxCount 1 ;
            sh:order 24 ;
            sh:path schema1:genre ],
        [ sh:class schema1:CreativeWork ;
            sh:description "External sources supporting claims in the body." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path schema1:citation ],
        [ sh:class lokf:Concept ;
            sh:description "A concept that is a part of this concept." ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path schema1:hasPart ],
        [ sh:class lokf:Concept ;
            sh:description "The subject matter this concept is about." ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path schema1:about ],
        [ sh:description "A URI that uniquely identifies the underlying real-world asset the concept describes (a table console URL, an API base URL, etc.). Absent for purely abstract concepts." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:string ;
            sh:description "Short cross-cutting keywords for categorization." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path schema1:keywords ],
        [ sh:datatype xsd:date ;
            sh:description "Absolute date (YYYY-MM-DD) on or after which the concept is stale (stale when today >= stale_after). schema:expires is the exact concept — a planned future expiry; prov:invalidatedAtTime would falsely assert the entity WAS invalidated, and dcterms:valid names a validity period only ambiguously." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path schema1:expires ],
        [ sh:class dcterms:PeriodOfTime ;
            sh:description "The `{ from, to }` date range framing every `usage_count`. Attached both to Concept (the shared window, sibling of `sources`) and to Source (a per-entry override)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 26 ;
            sh:path lokf:usageWindow ],
        [ sh:datatype xsd:string ;
            sh:description "A single-sentence summary of the concept." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:description ],
        [ sh:class lokf:Concept ;
            sh:description "The target concept that this concept is a part of." ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path dcterms:isPartOf ],
        [ sh:datatype xsd:string ;
            sh:description "The concept's type. OKF's single required field. In LOKF the value SHOULD name a LOKF class (e.g. Metric, Dataset, Table, Playbook, GlossaryTerm); it designates the JSON-LD @type / rdf:type. Consumers MUST tolerate unknown values by treating the concept as a generic lokf:Concept." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path lokf:type ] ;
    sh:targetClass lokf:Concept .


