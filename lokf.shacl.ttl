lokf:Explanation a sh:NodeShape ;
    rdfs:comment "An understanding-oriented, discursive treatment of a topic that permits reflection. The Diátaxis explanation mode as a first-class concept type; typically links to its subject matter with `about`." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class lokf:Concept ;
            sh:description "An entity this concept was derived from (provenance)." ;
